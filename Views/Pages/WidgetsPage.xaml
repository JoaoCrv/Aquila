<Page x:Class="Aquila.Views.Pages.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Aquila.Controls"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Widgets"
      Style="{StaticResource BasePageStyle}"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <StackPanel Margin="20,0,20,20">

        <TextBlock Text="Widgets" FontSize="18" FontWeight="SemiBold" Margin="2,12,0,0"/>

        <!-- Desktop surface (#24). It lives here rather than in Settings because this is where widgets are
             managed, and one owner avoids two views holding the same state. -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="Desktop"/>

        <ui:CardControl Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Show widgets on the desktop"/>
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Above the wallpaper, behind your windows, and click-through."/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowOnDesktop}"/>
        </ui:CardControl>

        <!-- Disabled rather than hidden while the surface is off. These used to be revealed by expanding
             the card, which kept the page tidy but also kept the feature invisible until someone happened
             to turn the switch on. Greyed out, they say what the surface is for before it is enabled. -->
        <ui:CardControl Icon="{ui:SymbolIcon Options24}"
                        IsEnabled="{Binding ViewModel.ShowOnDesktop}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Manage widgets"/>
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Editing minimizes Aquila so you can see the desktop; a bar at the top brings it back. There you can drag widgets, and right-click one to change, remove, or send it to another screen."/>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Content="Add widget"
                    Icon="{ui:SymbolIcon Add24}"
                    Appearance="Primary"
                    Command="{Binding ViewModel.AddWidgetCommand}"/>
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Edit widgets"
                    Icon="{ui:SymbolIcon Edit24}"
                    Command="{Binding ViewModel.StartEditingCommand}"/>
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Identify screens"
                    Icon="{ui:SymbolIcon Tv24}"
                    Command="{Binding ViewModel.IdentifyScreensCommand}"/>
            </StackPanel>
        </ui:CardControl>

        <!-- What is actually out there. A widget that cannot draw is invisible on the desktop, and
             invisible is indistinguishable from deleted — this is the only place the difference shows. -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="On the desktop"/>
        <TextBlock Style="{StaticResource SettingHint}" Margin="2,-4,0,8"
                   Text="Every widget you have placed, whether or not it is drawing."/>

        <ItemsControl ItemsSource="{Binding ViewModel.Widgets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl>
                        <ui:CardControl.Icon>
                            <ui:SymbolIcon Symbol="Warning24"
                                           Foreground="{DynamicResource Aquila.Chrome.Caution}"
                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>
                        </ui:CardControl.Icon>
                        <ui:CardControl.Header>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Style="{StaticResource SettingHint}" Text="{Binding Detail}"/>
                                <!-- The reason, not just the fact: "no reading chosen" and "its sensor is
                                     gone" are different problems and want different fixes. -->
                                <TextBlock Style="{StaticResource SettingHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Aquila.Chrome.Caution}"
                                           Text="{Binding Problem}"
                                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Opacity="0.5" Margin="0,0,12,0"
                                       Text="{Binding Kind}"/>
                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Remove this widget"
                                       Command="{Binding DataContext.ViewModel.RemoveWidgetCommand,
                                                 RelativeSource={RelativeSource AncestorType=Page}}"
                                       CommandParameter="{Binding}"/>
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</Page>
