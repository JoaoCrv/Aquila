<UserControl x:Class="Aquila.Controls.Cards.FansCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             xmlns:models="clr-namespace:Aquila.Models"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="340">
    <!-- Self-contained fans card: a row per fan (name, duty-cycle bar, RPM) plus a CPU-fan trend
         sparkline. Bind FanRows (the FanRowItems to list) and CpuFan (the sensor to chart). Pure
         bindings, no computed state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="FANS" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding FanRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FanRowItem}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Fan.Name}"
                                           Style="{StaticResource RowLabel}"
                                           TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Grid.Column="1"
                                             Style="{StaticResource FanBar}"
                                             VerticalAlignment="Center"
                                             Value="{Binding BarValue, Mode=OneWay}"
                                             Maximum="{Binding BarMaximum, Mode=OneWay}"/>
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource RowValue}" FontSize="11"
                                           Opacity="0.55" Margin="6,0,4,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding DutyText}"
                                           Visibility="{Binding DutyText, Converter={StaticResource NullToCollapsed}}"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource RowValue}" FontSize="12" HorizontalAlignment="Right">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0} {1}" FallbackValue="--">
                                            <Binding Path="Fan.Value"/>
                                            <Binding Path="Fan.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="CPU FAN · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding CpuFan.History}"
                SeriesColor="{DynamicResource Aquila.Chart.NetDown}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
