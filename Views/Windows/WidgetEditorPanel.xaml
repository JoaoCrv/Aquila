<ui:FluentWindow x:Class="Aquila.Views.Windows.WidgetEditorPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Aquila.Controls"
        xmlns:helpers="clr-namespace:Aquila.Helpers"
        Title="Widget"
        Width="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="Manual">

    <!--
        The properties panel, docked to a screen edge while edit mode is on — the arrangement of an image
        editor rather than a dialog.

        It replaced a modal window, and the reason is not fashion: the whole point of edit mode is that the
        widgets are visible on the real desktop, and a modal that must be dismissed before you can touch
        one of them fights that. Here selecting a widget fills the panel, and every change lands on the
        desktop as it is made.

        There is no OK or Cancel. Dragging a widget already saved without asking, so a colour change asking
        for confirmation would have been the odd one out.
    -->

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedSensors" Source="{Binding ViewModel.Sensors}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Component"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:MatchConverter x:Key="Match"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- The reading opposite a label, e.g. "8 px". Same weight as the label: it reports the slider,
             it is not a heading of its own. -->
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="8,0,0,4"/>
        </Style>

        <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <!-- A name that reads as a title until you reach for it.
             A boxed input sitting under a picker showing the same word looks like two fields for one
             thing. Drawn as a heading with its edges hidden, it says what the preset is called; the
             edges appear under the pointer, which is the whole of the instruction "you may change this".
             A plain TextBox rather than ui:TextBox on purpose — the Fluent one brings a template with a
             clear button and its own chrome, none of which a title should have. -->
        <Style x:Key="InlineTitle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
                </Trigger>
                <!-- A built-in cannot be renamed. Faded rather than hidden: the name is still what you
                     came to read. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- No Border of its own: the panel IS a window, so its background, its rounded corners and its
         border come from the same FluentWindow style the main window uses. Painting them by hand meant
         a flat rectangle sitting next to a Mica one, and two places to change whenever the theme did. -->
    <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The whole panel is a drag handle: it has no title bar of its own, and being pinned to one
                 edge would eventually cover the very widget being edited. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10" MouseLeftButtonDown="Header_Drag">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Left" Margin="0,0,8,0" Padding="6,2"
                               Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}"
                               ToolTip="Back to the widget"
                               Visibility="{Binding ViewModel.EditingPreset, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding ViewModel.ClosePresetCommand}"/>
                    <TextBlock Text="{Binding ViewModel.PanelTitle}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Text="{Binding ViewModel.PanelSubtitle}"/>
            </StackPanel>

            <!-- Everything below is hidden until something is selected: an editor full of controls that
                 change nothing is worse than an empty panel saying so. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Expander.Expanded="OnCardExpanded">

                    <ui:CardExpander Icon="{ui:SymbolIcon Grid24}" IsExpanded="True">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Widget" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                                <ListBox ItemsSource="{Binding ViewModel.Kinds}"
                                         SelectedItem="{Binding ViewModel.SelectedKind}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <!-- Columns, not Rows="1". One row worked while there were three kinds and
                                         broke at five: each cell fell to about 70px and every description wrapped
                                         to four lines. Fixing the column count instead lets the list fill downwards
                                         as kinds are added — two of them, because the panel is a narrow column and
                                         three cells across it are narrower than the word "MiniSparkline". -->
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- No accent picker here any more: colour belongs to a reading, not to the widget,
                                 and each row above carries its own. -->
                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="Defaults to the sensor name"
                                            Text="{Binding ViewModel.Title, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardExpander>

                    <!-- Hidden for the kinds that read nothing. A backdrop has no sensor to pick, and a
                         sensor list it cannot use would be a choice with nowhere to go. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon DataHistogram24}"
                                     Visibility="{Binding ViewModel.ShowsDataSection, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Data" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <!-- A plain stack: in a scrolling panel nothing can stretch to fill, so the
                             Grid that used to make the list take the leftover height had none to take. The
                             list carries its own height instead. -->
                        <StackPanel Margin="0,14,0,0">

                            <TextBlock Text="Sensor" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" PlaceholderText="Search sensors…"
                                            Text="{Binding ViewModel.SensorFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                <!-- Picking and pressing are deliberately separate. A click that added straight
                                     from the list would be far too easy to do by accident while scrolling two
                                     hundred sensors. The label says which of the two things the press does. -->
                                <ui:Button Grid.Column="2" Appearance="Primary"
                                           Content="{Binding ViewModel.AddLabel}"
                                           IsEnabled="{Binding ViewModel.CanAdd}"
                                           Command="{Binding ViewModel.AddSeriesCommand}"/>
                            </Grid>
                            <!-- A height of its own, and a scrollbar of its own. Left to measure freely
                                 inside the panel's scroller it would grow to two hundred rows and push
                                 everything below it off the bottom. -->
                            <ListBox Margin="0,8,0,0" Height="240"
                                     ItemsSource="{Binding Source={StaticResource GroupedSensors}}"
                                     SelectedItem="{Binding ViewModel.SelectedSensor}">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Opacity="0.6" FontSize="11" Margin="0,8,0,2"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                            <!-- Live value: names alone are ambiguous when a machine reports a
                                                 dozen similar temperatures. -->
                                            <TextBlock Grid.Column="1" Opacity="0.6" Margin="12,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F1} {1}">
                                                        <Binding Path="Sensor.Value" FallbackValue="--"/>
                                                        <Binding Path="Sensor.Unit"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,4"
                                       Text="{Binding ViewModel.SeriesHint}"/>

                            <!-- What the widget draws, in the order it was added. Each row names a RAMP
                                 from the preset, not a colour: which colour a ramp shows depends on how the
                                 reading is doing, so there is nothing fixed to put in a swatch. Two readings
                                 on one ramp are one reading, which is why they start on different ones. -->
                            <ItemsControl ItemsSource="{Binding ViewModel.Chosen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Sensor.Display}"/>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding DataContext.ViewModel.RampNames,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Ramp}"/>
                                            <ui:Button Grid.Column="4"
                                                       Icon="{ui:SymbolIcon Dismiss24}"
                                                       ToolTip="Remove this reading"
                                                       Command="{Binding DataContext.ViewModel.RemoveSeriesCommand,
                                                                 RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- What it looks like lives here, in a file shared with every widget wearing it.
                         Changing the picker re-dresses THIS widget; editing the preset changes them all,
                         which is the point of it being a preset rather than thirty fields per widget. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon Color24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Preset" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,14,0,0" Expander.Expanded="OnCardExpanded">
                            <DockPanel>
                                <!-- Everything that acts on the preset showing in the list, in the order
                                     it is reached for: open it, copy it, then the rest. -->
                                <ui:Button x:Name="PresetMenuButton" DockPanel.Dock="Right" Margin="6,0,0,0"
                                           Icon="{ui:SymbolIcon MoreHorizontal24}"
                                           ToolTip="More"
                                           Click="OnPresetMenu">
                                    <ui:Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename" Click="OnRenamePreset"
                                                      IsEnabled="{Binding ViewModel.CanUpdatePreset}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Rename24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Set as default"
                                                      Command="{Binding ViewModel.SetAsDefaultCommand}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Star24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <!-- Off until they exist. A menu that hides what is coming
                                                 teaches nobody where it will be. The arrows point the way
                                                 the file travels: down and out of the app, up and into it. -->
                                            <MenuItem Header="Export preset…" IsEnabled="False">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Import preset…" IsEnabled="False">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowUpload24"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <!-- The one entry that cannot be undone by doing it again wears
                                                 the app's own alert colour. -->
                                            <MenuItem Header="Delete"
                                                      Foreground="{DynamicResource Aquila.Scheme.Alert}"
                                                      IsEnabled="{Binding ViewModel.CanUpdatePreset}"
                                                      Command="{Binding ViewModel.DeletePresetCommand}"
                                                      CommandParameter="{Binding ViewModel.SelectedPreset}">
                                                <MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Delete24"
                                                                   Foreground="{DynamicResource Aquila.Scheme.Alert}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </ui:Button.ContextMenu>
                                </ui:Button>

                                <!-- Beside the list, because it is about the preset in the list: it makes
                                     a new one FROM the one showing, rather than from nothing. -->
                                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                           Icon="{ui:SymbolIcon Copy24}"
                                           ToolTip="New preset, starting from this one"
                                           Command="{Binding ViewModel.NewPresetCommand}"/>

                                <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Content="Edit"
                                           Appearance="Primary" Icon="{ui:SymbolIcon Edit24}"
                                           Command="{Binding ViewModel.EditPresetCommand}"/>
                                <ComboBox ItemsSource="{Binding ViewModel.Presets}"
                                          SelectedItem="{Binding ViewModel.SelectedPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- The padlock marks what cannot be written over. On the
                                                     locked ones and not the others: the restriction is the
                                                     exception, so it is the exception that carries a mark. -->
                                                <ui:SymbolIcon Grid.Column="0" Symbol="LockClosed24"
                                                               FontSize="12" Opacity="0.55"
                                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>

                                                <ui:Button x:Name="Remove" Grid.Column="2"
                                                           Visibility="Collapsed" Appearance="Transparent"
                                                           Padding="4,0" Margin="8,0,0,0"
                                                           Icon="{ui:SymbolIcon Delete24}"
                                                           ToolTip="Delete this preset"
                                                           PreviewMouseLeftButtonDown="OnDeletePreset"/>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <!-- Shown on the row under the pointer, and never on a
                                                     locked one. The IsMouseOver condition also keeps it out
                                                     of the CLOSED picker for free: the same template draws
                                                     the selection box, where there is no ComboBoxItem above
                                                     it for the binding to find. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Value="True" Binding="{Binding IsMouseOver,
                                                                   RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                                        <Condition Value="False" Binding="{Binding IsBuiltIn}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Remove" Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <TextBox x:Name="PresetNameBox" Margin="-6,8,0,0" Style="{StaticResource InlineTitle}"
                                     IsEnabled="{Binding ViewModel.CanUpdatePreset}"
                                     ToolTip="Click to rename. Enter to keep it, Escape to put it back."
                                     KeyDown="OnPresetNameKey"
                                     Text="{Binding ViewModel.PresetName, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                       Opacity="0.5" TextWrapping="Wrap"
                                       Text="{Binding ViewModel.PresetNote}"/>

                            <!-- What is inside it, without opening it. A preset IS its ramps, so the
                                 ramps are the summary; the reach goes here too, because the number of
                                 widgets about to change is the reason to hesitate before Edit. -->
                            <Border Margin="0,10,0,0" Padding="10" CornerRadius="6" BorderThickness="1"
                                    Background="#20000000"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ViewModel.RampPreviews}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Left" Width="72"
                                                               VerticalAlignment="Center" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding Name}"/>
                                                    <UniformGrid Rows="1" Height="14">
                                                        <Border Background="{Binding Normal}"/>
                                                        <Border Background="{Binding Elevated}"/>
                                                        <Border Background="{Binding Alert}"/>
                                                        <Border Background="{Binding Critical}"/>
                                                    </UniformGrid>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   FontSize="11" Opacity="0.5"
                                                   Text="{Binding ViewModel.FontFamily}"/>
                                        <ui:Badge HorizontalAlignment="Left" Appearance="Light">
                                            <TextBlock FontSize="11" Text="{Binding ViewModel.WornBy}"/>
                                        </ui:Badge>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Only for the kinds made of words, and only the words themselves: how big they are
                         drawn is the preset's business. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon TextFont24}"
                                     Visibility="{Binding ViewModel.ShowsTextOptions, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Text" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,14,0,0">
                            <StackPanel Visibility="{Binding ViewModel.ShowsCaptionOptions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="CPU"
                                            Text="{Binding ViewModel.Caption, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Text="Add a reading below and it is written after this, with its unit."/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ViewModel.ShowsClockOptions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Shows" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ViewModel.ClockFormats}"
                                          SelectedItem="{Binding ViewModel.SelectedClockFormat}"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- How much data a chart shows, and against what scale. Both are questions about the
                         readings rather than about the look, so they stay with the widget. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon DataLine24}"
                                     Visibility="{Binding ViewModel.ShowsChartData, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Chart" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.WindowLabel}"/>
                                <TextBlock Text="Time window" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="20" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.PointCount}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                       Opacity="0.5" TextWrapping="Wrap"
                                       Text="Only the sensors this widget draws keep a longer history. A widened window fills from the right."/>

                            <TextBlock Text="Scale" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <ComboBox ItemsSource="{Binding ViewModel.Scales}"
                                      SelectedItem="{Binding ViewModel.SelectedScale}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                       Opacity="0.5" TextWrapping="Wrap"
                                       Text="From zero keeps widgets comparable. Fit to data uses the full height, but the scale moves."/>

                            <Grid Margin="0,10,0,0"
                                  Visibility="{Binding ViewModel.ScaleIsManual, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Min" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Max" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="0" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                              Value="{Binding ViewModel.ScaleMin, Mode=TwoWay}"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="2" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                              Value="{Binding ViewModel.ScaleMax, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Where it sits and how big it is, in exact numbers. Dragging and the wheel are the
                         quick way; these are for lining widgets up deliberately, and for fetching one back
                         when it has ended up somewhere off-screen. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon Ruler24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Layout" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,14,0,0">

                            <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="0" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                              Value="{Binding ViewModel.WidgetX, Mode=TwoWay}"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="2" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                              Value="{Binding ViewModel.WidgetY, Mode=TwoWay}"/>
                            </Grid>

                            <TextBlock Text="Size" Style="{StaticResource FieldLabel}" Margin="0,16,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Width" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Height" Style="{StaticResource FieldValue}" Margin="0,0,0,4"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="0" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                              Minimum="40" Maximum="4000"
                                              Value="{Binding ViewModel.WidgetWidth, Mode=TwoWay}"/>
                                <ui:NumberBox Grid.Row="1" Grid.Column="2" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                              Minimum="40" Maximum="4000"
                                              Value="{Binding ViewModel.WidgetHeight, Mode=TwoWay}"/>
                            </Grid>

                            <!-- Which widget draws on top where two overlap. "Layer" rather than "Z-index":
                                 the number is a z-index, but the thing being chosen is what sits in front. -->
                            <DockPanel Margin="0,16,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.Layer, StringFormat={}{0:F0}}"/>
                                <TextBlock Text="Layer" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="-5" Maximum="10"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding ViewModel.Layer}"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                       Opacity="0.5" TextWrapping="Wrap"
                                       Text="Where two widgets overlap, the higher layer draws in front. Below zero is behind everything else — where a backdrop belongs."/>
                        </StackPanel>
                    </ui:CardExpander>

                </StackPanel>
            </ScrollViewer>


            <!-- The same row, so the two views occupy the same space and only one is ever shown. Cheaper
                 than moving anything, and it keeps the header and the footer where they were. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Expander.Expanded="OnCardExpanded">

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Preview on desktop" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,0,0,6"/>
                        <!-- Written out rather than generated: ConverterParameter is not a dependency
                             property, so it cannot be bound to the item, and there are four states that
                             are never going to be five. -->
                        <UniformGrid Rows="1">
                            <ToggleButton Margin="0,0,4,0" Padding="4,3" FontSize="11" Content="Normal"
                                          IsChecked="{Binding ViewModel.PreviewState, Mode=TwoWay,
                                                      Converter={StaticResource Match}, ConverterParameter=Normal}"/>
                            <ToggleButton Margin="0,0,4,0" Padding="4,3" FontSize="11" Content="Elevated"
                                          IsChecked="{Binding ViewModel.PreviewState, Mode=TwoWay,
                                                      Converter={StaticResource Match}, ConverterParameter=Elevated}"/>
                            <ToggleButton Margin="0,0,4,0" Padding="4,3" FontSize="11" Content="Alert"
                                          IsChecked="{Binding ViewModel.PreviewState, Mode=TwoWay,
                                                      Converter={StaticResource Match}, ConverterParameter=Alert}"/>
                            <ToggleButton Padding="4,3" FontSize="11" Content="Critical"
                                          IsChecked="{Binding ViewModel.PreviewState, Mode=TwoWay,
                                                      Converter={StaticResource Match}, ConverterParameter=Critical}"/>
                        </UniformGrid>
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" FontSize="11"
                                   Opacity="0.5" TextWrapping="Wrap"
                                   Text="Draws every widget in that state while this panel is open — the only way to tune Critical without waiting for the machine to run hot."/>
                    </StackPanel>

                    <ui:CardExpander>
                        <ui:CardExpander.Header>
                            <TextBlock Text="Panel" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                        <controls:ColorField HorizontalAlignment="Left" Color="{Binding ViewModel.BackgroundColor, Mode=TwoWay}"

                                             Swatches="{Binding ViewModel.Swatches}"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.BackgroundOpacity, StringFormat={}{0:F0}%}"/>
                            <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding ViewModel.BackgroundOpacity}"/>

                        <TextBlock Text="Border" Style="{StaticResource FieldLabel}" Margin="0,20,0,4"/>
                        <controls:ColorField HorizontalAlignment="Left" Color="{Binding ViewModel.BorderColor, Mode=TwoWay}"

                                             Swatches="{Binding ViewModel.Swatches}"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.BorderOpacity, StringFormat={}{0:F0}%}"/>
                            <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding ViewModel.BorderOpacity}"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.BorderThickness, StringFormat={}{0:F0} px}"/>
                            <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding ViewModel.BorderThickness}"/>

                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.CornerRadius, StringFormat={}{0:F0} px}"/>
                            <TextBlock Text="Corners" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="24"
                                Value="{Binding ViewModel.CornerRadius}"/>

                        <TextBlock Text="Typeface" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.FontFamilies}"
                                  SelectedItem="{Binding ViewModel.FontFamily}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander>
                        <ui:CardExpander.Header>
                            <TextBlock Text="Colours" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       ToolTip="Delete this ramp"
                                       IsEnabled="{Binding ViewModel.CanDeleteRamp}"
                                       Command="{Binding ViewModel.DeleteRampCommand}"/>
                            <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Add24}"
                                       ToolTip="New ramp, starting from this one"
                                       Command="{Binding ViewModel.AddRampCommand}"/>
                            <ComboBox ItemsSource="{Binding ViewModel.RampNames}"
                                      SelectedItem="{Binding ViewModel.SelectedRampName}"/>
                        </DockPanel>

                        <!-- The ramp end to end. Four colours are hard to judge as four text boxes and
                             easy to judge as a strip, and this is the one part of a preset where the
                             relationship between the colours is the point. -->
                        <UniformGrid Rows="1" Height="8" Margin="0,10,0,0">
                            <Border Background="{Binding ViewModel.RampNormal}"/>
                            <Border Background="{Binding ViewModel.RampElevated}"/>
                            <Border Background="{Binding ViewModel.RampAlert}"/>
                            <Border Background="{Binding ViewModel.RampCritical}"/>
                        </UniformGrid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Normal" VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"/>
                                <controls:ColorField Grid.Column="1" HorizontalAlignment="Left"
                                                     Color="{Binding ViewModel.RampNormal, Mode=TwoWay}"
                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Elevated" VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"/>
                                <controls:ColorField Grid.Column="1" HorizontalAlignment="Left"
                                                     Color="{Binding ViewModel.RampElevated, Mode=TwoWay}"
                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Alert" VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"/>
                                <controls:ColorField Grid.Column="1" HorizontalAlignment="Left"
                                                     Color="{Binding ViewModel.RampAlert, Mode=TwoWay}"
                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Critical" VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabel}"/>
                                <controls:ColorField Grid.Column="1" HorizontalAlignment="Left"
                                                     Color="{Binding ViewModel.RampCritical, Mode=TwoWay}"
                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0,6,0,0" FontSize="11"
                                   Opacity="0.5" TextWrapping="Wrap"
                                   Text="Which of the four a reading is drawn in is decided by the reading itself, against the limits in Settings. A ramp with four equal colours simply never changes."/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander
                                         Visibility="{Binding ViewModel.ShowsDial, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Dial" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.ArcThickness, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Arc thickness" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="2" Maximum="40"
                                    Value="{Binding ViewModel.ArcThickness}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.ArcCorner, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Arc ends" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="20"
                                    Value="{Binding ViewModel.ArcCorner}"/>
                            <TextBlock Text="Sweep" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding ViewModel.Sweeps}"
                                      SelectedItem="{Binding ViewModel.Sweep}"/>

                                <TextBlock Text="Track" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                <controls:ColorField HorizontalAlignment="Left" Color="{Binding ViewModel.TrackColor, Mode=TwoWay}"

                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.TrackOpacity, StringFormat={}{0:F0}%}"/>
                                <TextBlock Text="Track opacity" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding ViewModel.TrackOpacity}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander
                                         Visibility="{Binding ViewModel.ShowsLine, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Line" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.LineThickness, StringFormat={}{0:F1} px}"/>
                                <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0.5" Maximum="6"
                                    Value="{Binding ViewModel.LineThickness}"/>
                            <TextBlock Text="Fill" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding ViewModel.Fills}"
                                      SelectedItem="{Binding ViewModel.LineFill}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.FillOpacity, StringFormat={}{0:F0}%}"/>
                                <TextBlock Text="Fill opacity" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding ViewModel.FillOpacity}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.Smoothness, StringFormat={}{0:F0}%}"/>
                                <TextBlock Text="Smoothness" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="100"
                                    Value="{Binding ViewModel.Smoothness}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.PointSize, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Points" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="10"
                                    Value="{Binding ViewModel.PointSize}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander
                                         Visibility="{Binding ViewModel.ShowsBar, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Bar" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.BarThickness, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Thickness" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="2" Maximum="40"
                                    Value="{Binding ViewModel.BarThickness}"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.BarCorner, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Corners" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="20"
                                    Value="{Binding ViewModel.BarCorner}"/>
                            <TextBlock Text="Layout" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding ViewModel.Layouts}"
                                      SelectedItem="{Binding ViewModel.BarLayout}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander
                                         Visibility="{Binding ViewModel.ShowsNumber, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Number" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.UnitSize, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Unit size" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="0" Maximum="24"
                                    Value="{Binding ViewModel.UnitSize}"/>
                            <CheckBox Margin="0,10,0,0" Content="Panel behind the number"
                                      IsChecked="{Binding ViewModel.NumberPanel}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander>
                        <ui:CardExpander.Header>
                            <TextBlock Text="Title" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.TitleSize, StringFormat={}{0:F0} px}"/>
                            <TextBlock Text="Title size" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="6" Maximum="24"
                                Value="{Binding ViewModel.TitleSize}"/>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                       Text="{Binding ViewModel.TitleOpacity, StringFormat={}{0:F0}%}"/>
                            <TextBlock Text="Title opacity" Style="{StaticResource FieldLabel}"/>
                        </DockPanel>
                        <Slider Minimum="0" Maximum="100"
                                Value="{Binding ViewModel.TitleOpacity}"/>
                        <TextBlock Text="Title side" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                        <ComboBox ItemsSource="{Binding ViewModel.Placements}"
                                  SelectedItem="{Binding ViewModel.TitlePlacement}"/>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander
                                         Visibility="{Binding ViewModel.ShowsValue, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Reading" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}"
                                           Text="{Binding ViewModel.ValueSize, StringFormat={}{0:F0} px}"/>
                                <TextBlock Text="Reading size" Style="{StaticResource FieldLabel}"/>
                            </DockPanel>
                            <Slider Minimum="8" Maximum="64"
                                    Value="{Binding ViewModel.ValueSize}"/>
                            <TextBlock Text="Reading align" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ComboBox ItemsSource="{Binding ViewModel.Alignments}"
                                      SelectedItem="{Binding ViewModel.ValueAlign}"/>

                            <StackPanel Visibility="{Binding ViewModel.CanHideValue, Converter={StaticResource BoolToVisibility}}">
                                <CheckBox Margin="0,10,0,0" Content="Show the reading"
                                          IsChecked="{Binding ViewModel.ValueShown}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Text="Off leaves the dial or bar drawing on its own, with the title above it."/>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Content="Add widget" Appearance="Primary"
                           Icon="{ui:SymbolIcon Add24}"
                           Click="Add_Click"/>
                <ui:Button Margin="8,0,0,0" Content="Remove"
                           Icon="{ui:SymbolIcon Delete24}"
                           IsEnabled="{Binding ViewModel.HasTarget}"
                           Click="Remove_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Content="Done" Appearance="Primary"
                           Icon="{ui:SymbolIcon Checkmark24}"
                           Command="{Binding ViewModel.ClosePresetCommand}"/>
            </StackPanel>
    </Grid>
</ui:FluentWindow>
