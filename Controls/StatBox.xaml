<UserControl x:Class="Aquila.Controls.StatBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="70">
    <!-- A small "stat box": big value + small unit, with a caption underneath, on a rounded fill.
         Reused across the dashboard cards. Set Accent to colour the value; leave it unset to
         inherit the theme foreground. -->
    <Border Style="{StaticResource StatBox}">
        <StackPanel>
            <TextBlock x:Name="ValueText" Style="{StaticResource StatBoxValue}">
                <Run Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <Run Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     FontSize="{Binding UnitSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource StatBoxLabel}"
                       Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Border>
</UserControl>
