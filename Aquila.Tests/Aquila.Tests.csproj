<Project Sdk="Microsoft.NET.Sdk">

  <!-- Property-based tests. Each states a rule that must hold for EVERY input, and FsCheck generates hundreds of
       inputs nobody would have written by hand, shrinking any that breaks the rule down to the smallest one that
       still does. Nothing here ships: the installer is published from Aquila.csproj alone. -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Locked like the app: the packages are checked against their hashes in CI. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aquila.csproj" />
  </ItemGroup>

</Project>
