<Application
    x:Class="Aquila.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:helpers="clr-namespace:Aquila.Helpers"
    DispatcherUnhandledException="OnDispatcherUnhandledException"
    Exit="OnExit"
    Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- The theme overlay (Themes/<Name>/Dark.xaml or Light.xaml) is not merged here: it is
                     chosen at runtime and swapped by AppearanceService. Base.xaml is, because it
                     holds the profile role keys that must exist before anything renders. -->
                <!-- Values first, then rules: a rule resolves a token, so the token has to exist by the
                     time it is read. A theme overlay is merged on top of these at runtime. -->
                <ResourceDictionary Source="Themes/Base.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters used by more than one file, declared once. Each card carried its own
                 WidthThreshold and Intensity, thirty declarations in all, and two keys were spelled two
                 ways (BoolToVisibility / BoolToVisibilityConverter), so markup could not move between
                 files without its converters being renamed. A converter one file uses stays in that file. -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <helpers:IntensityBrushConverter x:Key="Intensity"/>
            <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <helpers:ThroughputConverter x:Key="Throughput"/>
            <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
