{
  "id": "ember",
  "name": "Ember",
  "author": "Aquila",
  "description": "Aquila's own. Drawn from the app's chrome: the same warm dark surface, the same ember accent, and colour that measures how hot something is rather than naming which component it is — the icon already does that.",
  "ramps": {
    "primary": {
      "normal": "#F5A623",
      "elevated": "#FF8C42",
      "alert": "#FF6B35",
      "critical": "#DA3B01"
    },
    "secondary": {
      "normal": "#FFD9A8",
      "elevated": "#FFB765",
      "alert": "#FF6B35",
      "critical": "#DA3B01"
    }
  },
  "background": {
    "color": "#1F1A16",
    "opacity": 0.82
  },
  "border": {
    "color": "#2B2420",
    "opacity": 1.0,
    "thickness": 1,
    "cornerRadius": 8
  },
  "gauge": {
    "ramp": "primary",
    "thickness": 14,
    "corner": 0,
    "sweep": "Dial",
    "track": {
      "color": "#FFFFFF",
      "opacity": 0.08
    }
  },
  "line": {
    "ramps": [
      "primary",
      "secondary"
    ],
    "thickness": 1.5,
    "fill": "Gradient",
    "fillOpacity": 0.3,
    "smoothness": 0.5,
    "pointSize": 0
  },
  "bar": {
    "ramp": "primary",
    "thickness": 6,
    "corner": 3,
    "layout": "Beside"
  },
  "number": {
    "ramp": "primary",
    "size": 20,
    "unitSize": 13,
    "panel": false
  },
  "title": {
    "size": 11,
    "opacity": 0.55,
    "align": "Center"
  },
  "value": {
    "size": 18,
    "opacity": 1.0,
    "align": "Center"
  }
}
