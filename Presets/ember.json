{
  "id": "ember",
  "name": "Ember",
  "author": "Aquila",
  "description": "Aquila's own profile, drawn from the logo. Warm and monochrome: colour measures how hot something is rather than naming which component it is — the icon already does that.",
  "ramps": {
    "primary": {
      "normal": "#FFB765",
      "elevated": "#F5A623",
      "alert": "#FF6B35",
      "critical": "#DA3B01"
    },
    "secondary": {
      "normal": "#FFD9A8",
      "elevated": "#F5A623",
      "alert": "#FF6B35",
      "critical": "#DA3B01"
    }
  },
  "background": {
    "color": "#000000",
    "opacity": 0.6
  },
  "border": {
    "color": "#FFFFFF",
    "opacity": 0.25,
    "thickness": 0,
    "cornerRadius": 8
  },
  "gauge": {
    "ramp": "primary",
    "thickness": 14,
    "corner": 0,
    "sweep": "Dial",
    "track": {
      "color": "#F5A623",
      "opacity": 0.13
    }
  },
  "line": {
    "ramps": [
      "primary",
      "secondary"
    ],
    "thickness": 1.5,
    "fill": "Gradient",
    "fillOpacity": 0.3,
    "smoothness": 0.5,
    "pointSize": 0
  },
  "bar": {
    "ramp": "primary",
    "thickness": 6,
    "corner": 3,
    "layout": "Beside"
  },
  "number": {
    "ramp": "primary",
    "size": 20,
    "unitSize": 13,
    "panel": false
  },
  "title": {
    "size": 11,
    "opacity": 0.6,
    "align": "Center"
  },
  "value": {
    "size": 18,
    "opacity": 1,
    "align": "Center"
  }
}
