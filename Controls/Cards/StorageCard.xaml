<UserControl x:Class="Aquila.Controls.Cards.StorageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="340">
    <!-- Self-contained storage card: temp/used stat boxes (reusing StatBox), read/write throughput
         rows with bars, and a read+write I/O sparkline. Bind Storage. Pure bindings, no computed
         state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:ThermalBrushConverter x:Key="Thermal"/>
        <helpers:ThroughputConverter x:Key="Throughput"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: name + stats + I/O rows -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="{Binding Storage.Name}" Style="{StaticResource ChipName}" Margin="0,0,0,10"
                           TextTrimming="CharacterEllipsis"/>
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <controls:StatBox Label="Temp" Unit="°C" Margin="0,0,3,0"
                        Value="{Binding Storage.Temperature.Primary.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                        Accent="{Binding Storage.Temperature.Primary.Value, Converter={StaticResource Thermal}}"/>
                    <controls:StatBox Label="Used" Unit="%" Margin="3,0,0,0"
                        Value="{Binding Storage.Load.UsedSpace.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                </UniformGrid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Read" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Aquila.Cpu}"
                               Text="{Binding Storage.Throughput.ReadRate.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                </Grid>
                <ProgressBar Style="{StaticResource CpuBar}" Margin="0,2,0,6"
                             Value="{Binding Storage.Throughput.ReadRate.Value, FallbackValue=0}"
                             Maximum="{Binding Storage.Throughput.ReadRate.Max, FallbackValue=1}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Write" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Aquila.Ram}"
                               Text="{Binding Storage.Throughput.WriteRate.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                </Grid>
                <ProgressBar Style="{StaticResource RamBar}" Margin="0,2,0,6"
                             Value="{Binding Storage.Throughput.WriteRate.Value, FallbackValue=0}"
                             Maximum="{Binding Storage.Throughput.WriteRate.Max, FallbackValue=1}"/>
                <TextBlock Text="I/O · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Storage.Throughput.ReadRate.History}"
                SeriesColor="{DynamicResource Aquila.Chart.Cpu}"
                SecondValues="{Binding Storage.Throughput.WriteRate.History}"
                SecondColor="{DynamicResource Aquila.Chart.Ram}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
