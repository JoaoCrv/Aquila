<UserControl x:Class="Aquila.Controls.Cards.StorageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="340">
    <!-- Self-contained storage card: temp/used stat boxes (reusing StatBox), read/write throughput
         rows with bars, and a read+write I/O sparkline. Bind Storage. Pure bindings, no computed
         state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:IntensityBrushConverter x:Key="Intensity"/>
        <helpers:ThroughputConverter x:Key="Throughput"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
    </UserControl.Resources>

    <ui:Card controls:Surface.Kind="Card" Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: name + stats + I/O rows -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardIconChip}" Margin="0,0,9,0">
                        <ui:SymbolIcon Symbol="Storage24" FontSize="15"
                                       Foreground="{DynamicResource Aquila.Scheme.Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Storage.Name}" Style="{StaticResource ChipName}"/>
                        <!-- Temperature moves here rather than sitting alone in a full-width box: with
                             used space promoted to the headline, a single stat box left the card mostly
                             empty and reading lighter than every other one on the page. -->
                        <TextBlock FontSize="11" Margin="0,1,0,0"
                                   Style="{StaticResource MonoValue}" FontWeight="Normal"
                                   Foreground="{Binding Storage.Temperature.Primary.Value, Converter={StaticResource Intensity}, ConverterParameter=Storage.Temperature}"
                                   Text="{Binding Storage.Temperature.Primary.Value, StringFormat='{}{0:F0} °C', FallbackValue=''}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource CardBigValue}"
                                   Text="{Binding Storage.Load.UsedSpace.Value, StringFormat='{}{0:F0}', FallbackValue='--', TargetNullValue='--'}"/>
                        <TextBlock Style="{StaticResource CardBigUnit}" Text="%"/>
                    </StackPanel>
                </Grid>
                <controls:SensorMeter LabelPlacement="Top" ColorValue="True" Label="Read"
                    Sensor="{Binding Storage.Throughput.ReadRate}" Accent="{DynamicResource Aquila.Scheme.Series1}"
                    ValueText="{Binding Storage.Throughput.ReadRate.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                <controls:SensorMeter LabelPlacement="Top" ColorValue="True" Label="Write"
                    Sensor="{Binding Storage.Throughput.WriteRate}" Accent="{DynamicResource Aquila.Scheme.Series2}"
                    ValueText="{Binding Storage.Throughput.WriteRate.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                <TextBlock Text="I/O · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Storage.Throughput.ReadRate.History}"
                SeriesColor="{DynamicResource Aquila.Scheme.Series1}"
                SecondValues="{Binding Storage.Throughput.WriteRate.History}"
                SecondColor="{DynamicResource Aquila.Scheme.Series1}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
