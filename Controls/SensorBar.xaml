<UserControl x:Class="Aquila.Controls.SensorBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:primitives="clr-namespace:Aquila.Controls.Primitives"
             mc:Ignorable="d"
             d:DesignWidth="160">
    <!-- Horizontal bar for one sensor, drawn by BarFill; the code-behind maps the SensorNode onto a share of the
         scale and applies the accent colour and the look (sibling of RadialGauge / ChartTile — all take a live
         SensorNode). -->
    <primitives:BarFill x:Name="Bar"/>
</UserControl>
