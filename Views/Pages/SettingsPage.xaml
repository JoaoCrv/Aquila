<Page
    x:Class="Aquila.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Aquila.Helpers"
    xmlns:local="clr-namespace:Aquila.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingsPage"
    d:DataContext="{d:DesignInstance local:SettingsPage,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    Style="{StaticResource BasePageStyle}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Windows-Settings shape: groups are expandable cards, and inside each one a setting is a row
             with its name and explanation on the left and its control on the right. Shared styles keep
             the rows consistent instead of each one drifting on its own margins. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="GroupHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Page.Resources>

    <StackPanel>

        <!-- Personalization -->
        <ui:CardExpander Icon="{ui:SymbolIcon Color24}" IsExpanded="True">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Personalization" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource GroupHint}" Text="The theme dresses the window; the colour profile dresses the data. They are chosen separately." />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <!-- Style and brightness are two orthogonal choices, so they get two controls rather than
                     one list of every combination — which would also put an ambiguous "System" among
                     them. Adding a third style later costs one entry here instead of three. -->
                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Theme" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Aquila is our own look. Windows Fluent leaves the app plain, including your Windows accent colour." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                              ItemsSource="{Binding ViewModel.ThemeStyleOptions}"
                              SelectedItem="{Binding ViewModel.SelectedThemeStyle}"
                              DisplayMemberPath="Label" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Brightness" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Match Windows follows the system light/dark setting." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                              ItemsSource="{Binding ViewModel.ThemeOptions}"
                              SelectedItem="{Binding ViewModel.SelectedTheme}"
                              DisplayMemberPath="Label" />
                </Grid>

                <!-- Colour profile: one JSON file each, ours embedded and the user's in
                     Documents\Aquila\profiles. Duplicate is the only way to edit one of ours, which is
                     deliberate — a built-in that cannot be broken is always somewhere to get back to. -->
                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Colour profile" />
                        <TextBlock Style="{StaticResource SettingHint}"
                                   Text="{Binding ViewModel.ColorProfileDescription, Mode=OneWay}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="160"
                              ItemsSource="{Binding ViewModel.ColorProfiles}"
                              SelectedItem="{Binding ViewModel.SelectedColorProfile}"
                              DisplayMemberPath="DisplayName" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
                    <ui:Button Content="Duplicate to edit"
                               Icon="{ui:SymbolIcon Copy24}"
                               Command="{Binding ViewModel.DuplicateColorProfileCommand, Mode=OneWay}" />
                    <ui:Button Margin="8,0,0,0" Content="Open folder"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding ViewModel.OpenProfilesFolderCommand, Mode=OneWay}" />
                    <ui:Button Margin="8,0,0,0" Content="Reload"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               Command="{Binding ViewModel.ReloadColorProfilesCommand, Mode=OneWay}" />
                </StackPanel>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Polling interval" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="How often hardware is read. Shorter is more responsive and uses a little more CPU." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" MinWidth="120"
                              ItemsSource="{Binding ViewModel.PollingIntervalOptions}"
                              SelectedItem="{Binding ViewModel.SelectedPollingInterval}"
                              DisplayMemberPath="Label" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- Behaviour -->
        <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon Window24}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Behaviour" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource GroupHint}" Text="Startup, the tray, and dashboard mode." />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Minimize to tray" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Closing the window leaves Aquila running in the notification area." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ViewModel.MinimizeToTray}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Start minimized" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Launch straight to the tray, without opening the window." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ViewModel.StartMinimized}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Runs at logon. Requires the elevation task, since reading some sensors needs administrator rights." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ViewModel.StartWithWindows}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Start in dashboard mode" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Runs Aquila as an appliance: the dashboard opens at logon and the main window waits in the tray. Turning this on also enables the three settings above; you can change them afterwards." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ViewModel.DashboardMode}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- Dashboard cards -->
        <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon Grid24}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Dashboard cards" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource GroupHint}" Text="Choose what the dashboard shows. Hidden cards are excluded from the layout entirely." />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,4,0,0">
                <ui:ToggleSwitch Content="CPU" IsChecked="{Binding ViewModel.ShowCpuCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Memory" IsChecked="{Binding ViewModel.ShowMemoryCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="GPU" IsChecked="{Binding ViewModel.ShowGpuCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Network" IsChecked="{Binding ViewModel.ShowNetworkCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Storage" IsChecked="{Binding ViewModel.ShowStorageCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Temperatures" IsChecked="{Binding ViewModel.ShowTemperaturesCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Power" IsChecked="{Binding ViewModel.ShowPowerCard}" />
                <ui:ToggleSwitch Margin="0,6,0,0" Content="Fans" IsChecked="{Binding ViewModel.ShowFansCard}" />
            </StackPanel>
        </ui:CardExpander>

        <!-- Diagnostics -->
        <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon Bug24}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource GroupHint}" Text="Logging and the raw sensor tree, for troubleshooting." />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel>
                <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Verbose logging" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Writes detailed logs to Documents\Aquila\logs\. Disabled by default." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding ViewModel.EnableVerboseLogging}" />
                </Grid>

                <Grid Style="{StaticResource SettingRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Sensor explorer" />
                        <TextBlock Style="{StaticResource SettingHint}" Text="Browse the raw sensor tree from LibreHardwareMonitor and export a full report. Useful for finding sensor identifiers." />
                    </StackPanel>
                    <ui:Button Grid.Column="1" VerticalAlignment="Center"
                               Command="{Binding ViewModel.OpenLhmExplorerCommand}"
                               Content="Open"
                               Icon="{ui:SymbolIcon DataHistogram24}" />
                </Grid>
            </StackPanel>
        </ui:CardExpander>

        <!-- Updates -->
        <ui:CardExpander Margin="0,4,0,20" Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource GroupHint}" Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                </StackPanel>
            </ui:CardExpander.Header>

            <StackPanel Margin="0,4,0,0">
                <TextBlock Style="{StaticResource SettingHint}" Margin="0"
                           Text="Aquila can check silently on startup and will notify you before any download or restart." />
                <TextBlock Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap"
                           Text="{Binding ViewModel.UpdateStatusMessage, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button Command="{Binding ViewModel.CheckForUpdatesCommand, Mode=OneWay}"
                               Content="Check for updates"
                               Icon="{ui:SymbolIcon ArrowDownload24}" />
                    <ui:ProgressRing Width="18" Height="18" Margin="10,0,0,0"
                                     VerticalAlignment="Center" IsIndeterminate="True"
                                     Visibility="{Binding ViewModel.IsCheckingForUpdates, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>
    </StackPanel>
</Page>
