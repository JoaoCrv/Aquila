<!--
    THE RULES.

    Every Style the app defines, in one place, shared by every theme — Fluent included. A theme brings
    VALUES (Themes/Base.xaml and Themes/<Name>/*.xaml); it never brings rules. If it did, the button style
    would be copied into each theme and fixing one padding would become one fix per theme, which is the
    scattering this file exists to end.

    Two rules hold it together:

      1. ALWAYS BasedOn. A Style without it replaces the control's template, and the control comes back
         stripped to the bone. It has happened twice — a ui:Card that vanished, and a header style that did
         nothing at all — both before this was written down.

      2. NO LITERAL COLOURS OR SIZES. Everything resolves a token, so a theme can change it. A literal here
         is a value a theme cannot reach, which makes the theme a half-truth.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Aquila.Controls"
                    xmlns:helpers="clr-namespace:Aquila.Helpers">

    <!-- ════════════════════════════════════════════════════════════════
         Surfaces and controls
         ════════════════════════════════════════════════════════════════ -->

    <!-- AN IMPLICIT STYLE FOR A KIT CONTROL MUST CHAIN TO THE KIT'S.

         Write `<Style TargetType="{x:Type ui:X}">` with no BasedOn and the app throws an ArgumentException
         while Application.Resources loads — before any window and before the first log line, so it looks
         like the app simply refuses to open. That is what this note used to forbid outright, and the ban
         was too wide: `BasedOn="{StaticResource {x:Type ui:X}}"` resolves the kit's style at parse time and
         extends it, and the CardExpander rule below plus the three field rules above have run that way
         without incident. Re-measured 2026-09-24 by starting the app, which is the only test that catches
         this failure.

         Prefer Surface.Kind where it fits regardless: it INHERITS, so a container declares it once for
         everything inside, and a per-window margin is a window's business rather than a rule. -->

    <!-- The same face and outline the icon buttons wear, on the controls you type or choose in. The
         design gives a combo the identical treatment as a button, and without it a combo over Mica is a
         word with a chevron beside it rather than a field.

         Implicit styles, done here rather than in one panel's resources because these controls appear on
         every page. See the note above for why chaining to the kit's style is what makes that safe. -->
    <!-- Height only. Colour stays the kit's, so Appearance="Primary" is still orange — what is being
         made uniform here is the row, not the palette.

         A MINIMUM, with the vertical padding taken away. Height was set outright first and it clipped: WPF
         does not shrink a padding to make content fit, it cuts — the word "Done" lost its lower half and a
         combo lost its bottom border, because the kit's padding plus a line of text asks for more than 32.
         With no vertical padding the content is about nineteen pixels and the minimum decides, so every
         control still lands on the same height; and anything that one day needs more grows instead of
         losing a piece of itself. -->
    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- The face lands on the quiet buttons and nowhere else. Hung on Secondary rather than set
                 outright and undone for Primary, because undoing means naming the kit's accent brushes and
                 they would then be ours to keep in step. If this ever stops matching the kit's default the
                 trigger simply does not fire: the buttons look as they did before, which is a failure worth
                 having. -->
            <Trigger Property="Appearance" Value="Secondary">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The plain WPF TextBox, which the kit restyles and the app still uses in two places. Left out, it
         would be the one field on screen with a different face. -->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
                <!-- Vertical padding, not zero. Zeroed, the bottom border vanished from every field: the kit lays
             the content AND the underline out from Padding, so with no room below there is nowhere for that
             line to be drawn. MinHeight still decides the height — content plus this is under 32 — so the
             row stays level and nothing is clipped, which is the whole point of a minimum. -->
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- A button that stays down. The four state buttons under "Preview on desktop" and the fill toggles:
         same face as everything else at rest, and when chosen an accent outline over a wash rather than a
         solid block — see the token for why. -->
    <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Aquila.Control.ChosenFill}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Aquila.Chrome.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Aquila.Control.ChosenText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- No face: a checkbox is a mark and a word, not a field. Only the height, so it sits on the same
         line as everything beside it. -->
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- A list is a field you pick in, so it wears the same face. No height: its own is the point. -->
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
                <!-- Vertical padding, not zero. Zeroed, the bottom border vanished from every field: the kit lays
             the content AND the underline out from Padding, so with no room below there is nowhere for that
             line to be drawn. MinHeight still decides the height — content plus this is under 32 — so the
             row stays level and nothing is clipped, which is the whole point of a minimum. -->
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
                <!-- Vertical padding, not zero. Zeroed, the bottom border vanished from every field: the kit lays
             the content AND the underline out from Padding, so with no room below there is nowhere for that
             line to be drawn. MinHeight still decides the height — content plus this is under 32 — so the
             row stays level and nothing is clipped, which is the whole point of a minimum. -->
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <Style TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
        <Setter Property="MinHeight" Value="{DynamicResource Aquila.Size.Control}"/>
                <!-- Vertical padding, not zero. Zeroed, the bottom border vanished from every field: the kit lays
             the content AND the underline out from Padding, so with no room below there is nowhere for that
             line to be drawn. MinHeight still decides the height — content plus this is under 32 — so the
             row stays level and nothing is clipped, which is the whole point of a minimum. -->
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>

    <!-- A line of status text, coloured by what it is REPORTING rather than by what it says.

         The kind is set on the element (controls:Status.Kind), so this is a rule about text and not a
         rule about one page. It first bound through the ancestor Page to a property named
         UpdateStatusKind, which worked exactly once and would have failed silently anywhere else.

         Triggers rather than a converter, so the brushes stay DynamicResource and follow a theme change
         while the message sits there unchanged. A converter resolves once, and the colour would be a
         theme behind until the next message arrived. -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Opacity" Value="0.8"/>
        <Style.Triggers>
            <Trigger Property="controls:Status.Kind" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource Aquila.Chrome.Success}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="controls:Status.Kind" Value="Caution">
                <Setter Property="Foreground" Value="{DynamicResource Aquila.Chrome.Caution}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="controls:Status.Kind" Value="Bad">
                <Setter Property="Foreground" Value="{DynamicResource Aquila.Chrome.Danger}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button carrying an icon and no words.

         The kit's padding is sized for a label, so an icon inside it sat in a wide, flat lozenge — which is
         what fifteen buttons in the widget editor looked like, two of which had a padding set by hand
         because somebody noticed and the other thirteen because nobody had yet.

         Square by construction, not by arithmetic. It used to set a padding and MinWidth 0 and hope: the
         width came out as the icon plus twelve while the height stayed at whatever minimum the kit imposes,
         so the two matched only by accident. Both sides are said now, from one token, and the padding goes
         to zero because a fixed square has no use for it — the icon is centred in the box instead. -->
    <Style x:Key="IconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Width" Value="{DynamicResource Aquila.Size.Control}"/>
        <Setter Property="Height" Value="{DynamicResource Aquila.Size.Control}"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- "Add one more" — an outline of where a thing would go, not a thing.
         A filled button of the same width as the list above it competes with the list; dashes read as an
         empty slot, which is what adding a ramp actually is. Taken from the design canvas, where every
         other button is solid and this one alone is not. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="{DynamicResource Aquila.Space.Snug}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Dashes" StrokeThickness="1" StrokeDashArray="3 3"
                                   RadiusX="{DynamicResource Aquila.Radius.ControlPx}"
                                   RadiusY="{DynamicResource Aquila.Radius.ControlPx}"
                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dashes" Property="Stroke"
                                    Value="{DynamicResource Aquila.Chrome.Accent}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         Pages — the frame a page is drawn in
         ════════════════════════════════════════════════════════════════ -->
    <Style x:Key="BasePageStyle" TargetType="{x:Type Page}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="ui:Design.Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="Margin" Value="12,16,12,24" />
    </Style>

    <!-- Shared by every page built from setting cards: the explanation under a card's title, and the
         plain text heading that groups them. Here rather than per page so the two do not drift. -->
    <Style x:Key="SettingHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,20,0,8" />
    </Style>

    <!-- BasedOn is not optional. An implicit style without it REPLACES the default rather than extending
         it, template included — the cards lost their chrome entirely and rendered as bare content. -->
    <Style TargetType="{x:Type ui:CardControl}" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- CardExpander has no hover of its own — its template (read from WPF-UI's source) triggers only on
         IsExpanded and IsEnabled. Its header border does use {TemplateBinding Background}, so a trigger
         here reaches the visual. Kept for the two sections that are still expanders.

         It lives at application level rather than in MainWindow.Resources because pages are loaded into
         the navigation frame, and a style sitting in the window did not reach them. -->
    <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ════════════════════════════════════════════════════════════════
         Typography — section headers, row labels and values
         ════════════════════════════════════════════════════════════════ -->

    <!-- Page-level section heading (e.g. "Behaviour", "Dashboard cards") -->
    <Style x:Key="PageSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Sub-section heading inside a card -->
    <Style x:Key="CardSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin"     Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.38"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         Numerals

         Readings are monospaced; labels and names are not. The split is the
         convention, not an oversight: the typeface says which of the two a
         piece of text is, so the eye finds the numbers without hunting.

         The rule that keeps it from reading as a mistake: a reading and its
         unit are ONE thing. "51" and "°C" are always set together — see
         CardBigUnit, and the unit Run inside StatBox.

         Tabular figures matter independently of the face. A value changes
         every second, and proportional digits would shift whatever sits
         beside them on every tick.

         Consolas is the fallback because it is always present on Windows;
         Cascadia Mono is not, and a missing font falls back silently to the
         UI face — which would quietly undo all of the above.
         ════════════════════════════════════════════════════════════════ -->

    <Style x:Key="MonoValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- The card's headline reading, promoted out of the stat row into the header. -->
    <Style x:Key="CardBigValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="LineHeight" Value="27"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Unit beside a big value: present, but never competing with the number. Monospaced like the
         number it belongs to — "31" and "%" are one reading, and splitting a single reading across two
         typefaces is the one place the mixture reads as a mistake rather than as a convention. -->
    <Style x:Key="CardBigUnit" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity" Value="0.40"/>
        <Setter Property="Margin" Value="1,0,0,3"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         Card header icon

         Colour identifies nothing here — the icon does. The chip is tinted
         with the profile's track so it reads as part of the card rather
         than as a status light.
         ════════════════════════════════════════════════════════════════ -->

    <Style x:Key="CardIconChip" TargetType="Border">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Aquila.Scheme.Track}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="ChipName" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.50"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="RowValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="5,4"/>
    </Style>

    <Style x:Key="StatBoxValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatBoxLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity" Value="0.40"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
        <Setter Property="Opacity" Value="0.14"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         ThinBar — base progress bar template
         ════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ThinBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- Track comes from the profile, not from a neutral: a bar reads as one object when
                         its empty part is a dimmed version of its full part. -->
                    <Border Background="{DynamicResource Aquila.Scheme.Track}"
                            Height="{TemplateBinding Height}"
                            CornerRadius="{Binding Path=(controls:BarShape.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                        <Border x:Name="PART_Track" HorizontalAlignment="Left"
                                CornerRadius="{Binding Path=(controls:BarShape.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{TemplateBinding Foreground}">
                            <Border.Width>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <helpers:ProgressBarWidthConverter/>
                                    </MultiBinding.Converter>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         Named sensor bars — BasedOn ThinBar, colour from Aquila.* tokens
         ════════════════════════════════════════════════════════════════ -->

    <Style x:Key="GpuBar" TargetType="ProgressBar" BasedOn="{StaticResource ThinBar}">
        <Setter Property="Foreground" Value="{DynamicResource Aquila.Scheme.Accent}"/>
    </Style>

    <Style x:Key="RamBar" TargetType="ProgressBar" BasedOn="{StaticResource ThinBar}">
        <Setter Property="Foreground" Value="{DynamicResource Aquila.Scheme.Accent}"/>
    </Style>

    <Style x:Key="FanBar" TargetType="ProgressBar" BasedOn="{StaticResource ThinBar}">
        <Setter Property="Foreground" Value="{DynamicResource Aquila.Scheme.Accent}"/>
    </Style>
</ResourceDictionary>
