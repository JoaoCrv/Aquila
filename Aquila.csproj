<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <Version>2.2.1</Version>
	  <PackageVersion>$(Version).0</PackageVersion>
	  <PackageDisplayVersion>$(Version).0</PackageDisplayVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- packages.lock.json: every package, direct and transitive, at its exact version and with the hash of its
         content. Restore writes it when a package changes; CI and the release restore in locked mode, so a package
         whose content does not match its hash fails the build instead of shipping. win-x64 is listed so the lock
         also covers the graph the release is published for. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Drafts\**" />
    <Page Remove="Drafts\**" />
    <Resource Remove="Drafts\**" />
    <EmbeddedResource Remove="Drafts\**" />
    <None Remove="Drafts\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.ico" />
	  <Content Include="Assets\Images\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in presets, embedded rather than copied to the output folder: they can then be neither
         corrupted nor deleted, so there is always something to fall back to. The user's own live in
         Documents\Aquila\presets and override these by id. -->
    <EmbeddedResource Include="Presets\*.json" />
    <!-- One manifest per theme folder: the name for the picker, and the preset it suggests. -->
    <EmbeddedResource Include="Themes/**/theme.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\GITHUB_SETUP.md" />
    <None Include=".github\ISSUE_TEMPLATE\bug_report.md" />
    <None Include=".github\ISSUE_TEMPLATE\documentation.md" />
    <None Include=".github\ISSUE_TEMPLATE\feature_request.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.15" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="TaskScheduler" Version="2.12.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licences travel with the binaries, as MIT and Apache-2.0 ask and the MPL needs: Aquila's own, and every
         package it ships (generated by tools/Update-ThirdPartyNotices.ps1). The About page opens both. -->
    <Content Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Images\icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
