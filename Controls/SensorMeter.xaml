<UserControl x:Class="Aquila.Controls.SensorMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Aquila.Controls"
             mc:Ignorable="d"
             d:DesignWidth="220">
    <!-- One sensor as a labeled bar with a value. Two layouts, chosen via LabelPlacement: label|bar
         |value in a row (Inline, e.g. PowerCard), or label/value on top with the bar below (Top,
         e.g. StorageCard). Wraps SensorBar; Label/ValueText are plain strings the caller formats,
         same convention as StatBox. -->
    <Grid>
        <Grid x:Name="InlineLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="InlineLabelColumn" Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InlineValueColumn" Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                       Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <controls:SensorBar Grid.Column="1" VerticalAlignment="Center"
                Sensor="{Binding Sensor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Accent="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <TextBlock Grid.Column="2" Style="{StaticResource RowValue}"
                       Text="{Binding ValueText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>

        <StackPanel x:Name="TopLayout">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                           Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <TextBlock x:Name="TopValueText" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                           Text="{Binding ValueText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
            <controls:SensorBar Margin="0,2,0,6"
                Sensor="{Binding Sensor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Accent="{Binding Accent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </StackPanel>
    </Grid>
</UserControl>
