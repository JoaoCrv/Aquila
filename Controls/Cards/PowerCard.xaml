<UserControl x:Class="Aquila.Controls.Cards.PowerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="340">
    <!-- Self-contained power card: total system power, per-source rows (CPU / GPU / GPU 2) and a
         total-power trend sparkline. Bind TotalPower/CpuPower/Gpu1Power/Gpu2Power. Pure bindings, no
         computed state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="POWER" Style="{StaticResource SectionLabel}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardIconChip}" Margin="0,0,9,0">
                        <ui:SymbolIcon Symbol="Flash24" FontSize="14"
                                       Foreground="{DynamicResource Aquila.Scheme.Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="System total" Style="{StaticResource ChipName}"/>
                        <TextBlock Text="sum of reported sources" FontSize="10" Opacity="0.45" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource CardBigValue}"
                                   Text="{Binding TotalPower.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                        <TextBlock Style="{StaticResource CardBigUnit}" Text="W"/>
                    </StackPanel>
                </Grid>

                <controls:SensorMeter Margin="0,0,0,5" Label="CPU"
                    Sensor="{Binding CpuPower}" Accent="{DynamicResource Aquila.Scheme.Series1}"
                    ValueText="{Binding CpuPower.Value, StringFormat='{}{0:F0}W', FallbackValue='--'}"/>
                <controls:SensorMeter Margin="0,0,0,5" Label="GPU"
                    Sensor="{Binding Gpu1Power}" Accent="{DynamicResource Aquila.Scheme.Series2}"
                    ValueText="{Binding Gpu1Power.Value, StringFormat='{}{0:F0}W', FallbackValue='--'}"/>
                <controls:SensorMeter Margin="0,0,0,5" Label="GPU 2"
                    Sensor="{Binding Gpu2Power}" Accent="{DynamicResource Aquila.Scheme.Series3}"
                    ValueText="{Binding Gpu2Power.Value, StringFormat='{}{0:F0}W', FallbackValue='--'}"
                    Visibility="{Binding Gpu2Power, Converter={StaticResource NullToCollapsed}}"/>

                <TextBlock Text="TOTAL · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding TotalPower.History}"
                SeriesColor="{DynamicResource Aquila.Scheme.Series1}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
