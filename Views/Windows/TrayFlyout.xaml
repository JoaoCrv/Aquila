<ui:FluentWindow x:Class="Aquila.Views.Windows.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Aquila.Controls"
        Title="Aquila"
        Width="340"
        MinWidth="0"
        MinHeight="0"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="Manual">

    <!--
        What the tray icon opens: the machine at a glance, and the few things worth doing from there.

        Aquila normally lives in the tray with no window shown, and the tray had nothing to offer but a
        generic menu of four words. This is the Windows 11 arrangement instead — the network and volume
        flyouts, OneDrive's — a small panel above the taskbar, opened by a left click, gone when it loses
        the focus. The right click still gives the plain menu, as it does for every other tray icon.

        Everything on it is borrowed rather than rebuilt: the readings are the title bar's own VitalItems
        drawn by the same VitalPill, and the status line is the notice panel's headline. Nothing here can
        drift from the window it summarises, because none of it is a copy.

        Same four window attributes as MainWindow and the editor panel, so it wears Mica, the rounded
        corners and the theme like they do.
    -->

    <Grid Background="{DynamicResource Aquila.Window.Scrim}">
        <StackPanel Margin="16,14,16,16">

            <!-- The brand, as the title bar writes it, so the flyout reads as Aquila and not as a dialog. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="/Assets/Images/icon.png" Width="18" Height="18" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock Text="A Q U I L A" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Two by two: four pills in one row are wider than a flyout should be. -->
            <ItemsControl ItemsSource="{Binding TitleBar.Vitals}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:VitalPill Margin="0,0,6,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The notice panel cut to its first line: the worst thing currently true, or how many events
                 are waiting, or that there is nothing. Pressing it opens Aquila with the panel open, which
                 is where the rest of the sentence is. -->
            <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                       Margin="0,6,0,12" Click="OnNotices"
                       ToolTip="Open Aquila on its notices">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter Property="Opacity" Value="0.4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Notices.Indicator}" Value="Good">
                                        <Setter Property="Fill" Value="{DynamicResource Aquila.Chrome.Success}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Notices.Indicator}" Value="Caution">
                                        <Setter Property="Fill" Value="{DynamicResource Aquila.Chrome.Caution}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Notices.Indicator}" Value="Bad">
                                        <Setter Property="Fill" Value="{DynamicResource Aquila.Chrome.Danger}"/>
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Notices.Headline}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>

            <!-- Only while there is one, like the menu's entry and the icon's badge. -->
            <ui:Button x:Name="UpdateButton" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                       Icon="{ui:SymbolIcon ArrowDownload24}" Content="Update available — install…"
                       Visibility="Collapsed" Click="OnUpdate"/>

            <ui:Button Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                       Icon="{ui:SymbolIcon Home24}" Content="Open Aquila" Click="OnOpen"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:Button Grid.Column="0" HorizontalAlignment="Stretch"
                           Icon="{ui:SymbolIcon Edit24}" Content="Edit widgets" Click="OnEditWidgets"/>
                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Power24}" Content="Exit" Click="OnExit"/>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
