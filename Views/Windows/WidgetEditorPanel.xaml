<ui:FluentWindow x:Class="Aquila.Views.Windows.WidgetEditorPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Aquila.Controls"
        xmlns:vm="clr-namespace:Aquila.ViewModels.Windows"
        Title="Widget"
        Width="460"
        MinWidth="0"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="Manual">

    <!--
        The properties panel, docked to a screen edge while edit mode is on — the arrangement of an image
        editor rather than a dialog.

        It replaced a modal window, and the reason is not fashion: the whole point of edit mode is that the
        widgets are visible on the real desktop, and a modal that must be dismissed before you can touch
        one of them fights that. Here selecting a widget fills the panel, and every change lands on the
        desktop as it is made.

        There is no OK or Cancel. Dragging a widget already saved without asking, so a colour change asking
        for confirmation would have been the odd one out.

        460 wide, and MinWidth zero. The file said 380 for months and the panel was never 380: the kit's
        FluentWindow sets MinWidth=460, and the floor won without a word — measured at 460 by forcing the
        panel open and reading it back. Everything in it was laid out and judged at 460, so 460 is now what
        the file says; MinWidth=0 removes the hidden floor, so that changing this number from now on actually
        changes the panel.
    -->

    <Window.Resources>
        <Style TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="Margin" Value="{DynamicResource Aquila.Space.BetweenCards}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- The reading opposite a label, e.g. "8 px". Same weight as the label: it reports the slider,
             it is not a heading of its own. -->
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="8,0,0,4"/>
        </Style>

        <!-- A name that reads as a title until you reach for it.
             A boxed input sitting under a picker showing the same word looks like two fields for one
             thing. Drawn as a heading with its edges hidden, it says what the preset is called; the
             edges appear under the pointer, which is the whole of the instruction "you may change this".
             A plain TextBox rather than ui:TextBox on purpose — the Fluent one brings a template with a
             clear button and its own chrome, none of which a title should have. -->
        <Style x:Key="InlineTitle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorTertiaryBrush}"/>
                </Trigger>
                <!-- A built-in cannot be renamed. Faded rather than hidden: the name is still what you
                     came to read. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A group of things that belong together inside a tab: the type, the readings. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <!-- One kind in the type gallery. The current one wears the theme's chosen colours with a tick; the one
             under the pointer or the keys is lifted, which is how the arrows show where they are — so no focus
             rectangle of its own. A MenuToggle: the click chooses through the view model, and the tile shows. -->
        <Style x:Key="KindTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="4"/>
            <!-- Said outright: the kit's own ToggleButton style still applies under this one, and it does not
                 stretch, so each tile came out the width of its own preview. -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Tile" Padding="6" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Aquila.Chrome.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One preset in the Preset tab's list: a card-like row, lifted under the pointer or the keys, in the theme's
             chosen colours while this widget wears it. -->
        <Style x:Key="PresetRowStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Row" MinHeight="40" Padding="12,0,6,0" CornerRadius="6" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Aquila.Chrome.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A preset row's own menu: what can be done to that preset without wearing it. The menu takes the ROW as
             its data context when it opens (OnPresetRowMenu), so each entry acts on that preset and no other. -->
        <ContextMenu x:Key="PresetRowMenu" x:Shared="False">
            <MenuItem Header="Export…" Click="OnExportPreset">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
            <MenuItem Header="Delete" Click="OnDeleteRowPreset"
                      Foreground="{DynamicResource Aquila.Chrome.Danger}"
                      Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" Foreground="{DynamicResource Aquila.Chrome.Danger}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- One choice of a segmented control — a List's source. -->
        <Style x:Key="Segment" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="{DynamicResource Aquila.Size.Control}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" CornerRadius="4" BorderThickness="1" Background="Transparent"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}"/>
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Aquila.Chrome.Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A heading inside a tab: what the controls under it are about. -->
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- One option on a line, as Windows 11's Settings draws it and our own Settings page does: its name on the
             left, its control on the right. Tighter than the page's, because this panel is a third as wide. Not
             focusable: to the kit it is a button, and here there is nothing to press, so Tab goes straight to the
             control it holds. -->
        <Style x:Key="Row" TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="50"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <!-- The same thing inside a card that opens: a Row within a card would be a card inside a card, so here a
             rule between lines does what the gap between cards does outside. The rule is on top, and a section's
             first line takes it off with BorderThickness="0": that line is known, and it is never one that hides. -->
        <Style x:Key="Line" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border MinHeight="44" Padding="0,8" BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A step of the header's path back: the text's own colour, underlined, rather than a web page's blue. -->
        <Style x:Key="Crumb" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- One of the widget's three tabs. A MenuToggle, so the click asks the view model and the tab only shows
             the answer: a radio button would write its own state, and unchecking the last tab would write too.
             The open one is semibold in the primary text with a short accent bar under it; the others recede. -->
        <Style x:Key="TabHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- A click on a tab leaves the keys where they were, so the arrows go on moving the widget. -->
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Face" Height="40" Margin="0,0,24,0" Background="Transparent" Opacity="0.7">
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.FontSize="14"/>
                            <Border x:Name="Indicator" Width="16" Height="3" CornerRadius="1.5"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Hidden"
                                    Background="{DynamicResource Aquila.Chrome.Accent}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="1"/>
                                <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Everything that acts on a preset as a whole. One menu, used by the Preset tab and by the preset view's
             header: x:Shared is off, so each button has a menu of its own. -->
        <ContextMenu x:Key="PresetMenu" x:Shared="False">
            <MenuItem Header="Rename" Click="OnRenamePreset"
                      IsEnabled="{Binding ViewModel.CanUpdatePreset}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Rename24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Set as default"
                      Command="{Binding ViewModel.SetAsDefaultCommand}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Star24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <!-- The arrows point the way the file travels: down and out
                 of the app, up and into it. -->
            <MenuItem Header="Export preset…" Click="OnExportPreset">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Import preset…" Click="OnImportPreset">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowUpload24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <!-- The one entry that cannot be undone by doing it again wears
                 the app's own alert colour. -->
            <MenuItem Header="Delete"
                      Foreground="{DynamicResource Aquila.Chrome.Danger}"
                      IsEnabled="{Binding ViewModel.CanUpdatePreset}"
                      Command="{Binding ViewModel.DeletePresetCommand}"
                      CommandParameter="{Binding ViewModel.SelectedPreset}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24"
                                   Foreground="{DynamicResource Aquila.Chrome.Danger}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <!-- No Border of its own: the panel IS a window, so its background, its rounded corners and its
         border come from the same FluentWindow style the main window uses. Painting them by hand meant
         a flat rectangle sitting next to a Mica one, and two places to change whenever the theme did. -->
    <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The header says where you are: the widget, or the preset you went into from it, each step a way
                 back. All of it is the panel's handle — the panel has no title bar of its own, and wherever it is
                 docked it may one day cover the widget being edited. Dragged, it stays where it is left; a
                 double-click docks it again. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6" MouseLeftButtonDown="Header_Drag">
                <DockPanel>
                    <!-- The widget's own actions sit beside its name. They lived in a footer at the bottom of a
                         scrolling panel, as far as they could be from the thing they act on.

                         Icons, not labelled buttons: full buttons would turn the header into a toolbar, and the
                         header is also the handle the panel is dragged by. Duplicate and Remove in the widget's
                         view; the preset's menu in the preset's. Close always: the panel exists only while a widget
                         is selected, and closing it is letting go of the selection. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       ToolTip="Duplicate (Ctrl+D)" AutomationProperties.Name="Duplicate (Ctrl+D)"
                                       Click="Duplicate_Click"/>
                            <ui:Button Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       ToolTip="Remove (Del) — Discard brings it back" AutomationProperties.Name="Remove (Del) — Discard brings it back"
                                       Click="Remove_Click"/>
                            <Border Width="1" Height="20" Margin="8,0,2,0" Opacity="0.14"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                       ToolTip="More" AutomationProperties.Name="More"
                                       ContextMenu="{StaticResource PresetMenu}"
                                       Click="OnPresetMenu"/>
                            <Border Width="1" Height="20" Margin="8,0,2,0" Opacity="0.14"
                                    Background="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ui:Button Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                   Appearance="Transparent" BorderThickness="0"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   ToolTip="Close (Esc)" AutomationProperties.Name="Close (Esc)"
                                   Click="Close_Click"/>
                    </StackPanel>

                    <StackPanel>
                        <!-- "Widgets" goes up a level: it lets go of the widget and opens the bar's list of them.
                             In the preset view the widget's name is the way back to it, as Esc is. -->
                        <TextBlock FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Style="{StaticResource Crumb}" Click="OnWidgetsCrumb">Widgets</Hyperlink>
                            <Run Text=" › "/><Run Text="{Binding ViewModel.WidgetName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink Style="{StaticResource Crumb}" Click="OnWidgetsCrumb">Widgets</Hyperlink>
                            <Run Text=" › "/><Hyperlink Style="{StaticResource Crumb}"
                                                        Command="{Binding ViewModel.ClosePresetCommand}"><Run
                                Text="{Binding ViewModel.WidgetName, Mode=OneWay}"/></Hyperlink>
                            <Run Text=" › "/><Run Text="{Binding ViewModel.PanelTitle, Mode=OneWay}"/>
                        </TextBlock>

                        <TextBlock Text="{Binding ViewModel.PanelTitle}" FontSize="20" FontWeight="SemiBold"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}"/>
                        <!-- In the preset view the title IS the name, renamed where it is read. A boxed input
                             under a picker showing the same word looked like two fields for one thing. -->
                        <TextBox x:Name="PresetNameBox" Margin="-6,0,0,0" FontSize="20" Style="{StaticResource InlineTitle}"
                                 IsEnabled="{Binding ViewModel.CanUpdatePreset}"
                                 ToolTip="Click to rename. Enter to keep it, Escape to put it back."
                                 KeyDown="OnNameKey"
                                 Text="{Binding ViewModel.PresetName, UpdateSourceTrigger=LostFocus}"
                                 Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Text="{Binding ViewModel.PanelSubtitle}"/>
            </StackPanel>

            <!-- The widget, in three tabs by what each is about: what it reads and says, what it wears, and the
                 rest of how it is drawn and where. They replaced an accordion of six cards, where whatever was being
                 used spent its life below the fold. Each tab scrolls on its own, and the one open stays open as the
                 selection moves from widget to widget. -->
            <Grid Grid.Row="1"
                  Visibility="{Binding ViewModel.ShowsWidgetView, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Divider}" Margin="0" VerticalAlignment="Bottom"
                        Background="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <controls:MenuToggle Style="{StaticResource TabHeader}" Content="Content"
                                         Command="{Binding ViewModel.ShowTabCommand}"
                                         CommandParameter="{x:Static vm:PanelTab.Content}"
                                         IsChecked="{Binding ViewModel.SelectedTab, Mode=OneWay,
                                                     Converter={StaticResource Match}, ConverterParameter=Content}"/>
                    <controls:MenuToggle Style="{StaticResource TabHeader}" Content="Preset"
                                         Command="{Binding ViewModel.ShowTabCommand}"
                                         CommandParameter="{x:Static vm:PanelTab.Preset}"
                                         IsChecked="{Binding ViewModel.SelectedTab, Mode=OneWay,
                                                     Converter={StaticResource Match}, ConverterParameter=Preset}"/>
                    <controls:MenuToggle Style="{StaticResource TabHeader}" Content="Customize"
                                         Command="{Binding ViewModel.ShowTabCommand}"
                                         CommandParameter="{x:Static vm:PanelTab.Customize}"
                                         IsChecked="{Binding ViewModel.SelectedTab, Mode=OneWay,
                                                     Converter={StaticResource Match}, ConverterParameter=Customize}"/>
                </StackPanel>

                <!-- Content: what the widget is, what it reads, and the words it says. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ViewModel.SelectedTab, Converter={StaticResource Match}, ConverterParameter=Content}">
                    <StackPanel Margin="2,16,6,16">
                        <!-- The type: what the widget is, drawn as itself — its own readings, in its own preset — with
                             the way to change it. Change opens the gallery here, in the tab: every kind drawn the same
                             way, so the choice is made by looking rather than by reading names, and the card under it
                             says what a change would take away before it does. -->
                        <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Content="{Binding ViewModel.TypeButtonLabel}"
                                           Command="{Binding ViewModel.ToggleGalleryCommand}"/>
                                <Border DockPanel.Dock="Left" Width="72" Height="44" Margin="0,0,12,0" Padding="4"
                                        CornerRadius="4" Background="{DynamicResource Aquila.Window.Scrim}">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <controls:KindPreview Kind="{Binding ViewModel.SelectedKind}"
                                                              Sensors="{Binding ViewModel.GalleryReadings}"
                                                              Accent="{Binding ViewModel.PreviewAccent}"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ViewModel.SelectedKind.Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ViewModel.TypeSummary}" FontSize="12" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding ViewModel.IsGalleryOpen, Converter={StaticResource BoolToVisibility}}">
                            <!-- The arrows move between the tiles, Enter takes one, Esc closes; the tile under the
                                 pointer or the keys is the one the card below describes. -->
                            <ItemsControl x:Name="Gallery" Margin="-4,0" ItemsSource="{Binding ViewModel.GalleryKinds}"
                                          KeyboardNavigation.DirectionalNavigation="Contained"
                                          KeyboardNavigation.TabNavigation="Once">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:MenuToggle Style="{StaticResource KindTile}"
                                                             IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                             Command="{Binding DataContext.ViewModel.ChooseKindCommand,
                                                                       RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding Kind}"
                                                             MouseEnter="OnKindTileHovered"
                                                             GotKeyboardFocus="OnKindTileFocused">
                                            <StackPanel>
                                                <Border Height="52" Padding="6" CornerRadius="4"
                                                        Background="{DynamicResource Aquila.Window.Scrim}">
                                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                                        <controls:KindPreview
                                                            Kind="{Binding Kind}"
                                                            Sensors="{Binding DataContext.ViewModel.GalleryReadings,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Accent="{Binding DataContext.ViewModel.PreviewAccent,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </Viewbox>
                                                </Border>
                                                <DockPanel Margin="2,8,2,0">
                                                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Checkmark24" FontSize="14"
                                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Kind.Name}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </controls:MenuToggle>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding ViewModel.FocusedKind.Name, Mode=OneWay}" FontWeight="SemiBold"/><Run
                                             Text=" · "/><Run Text="{Binding ViewModel.FocusedKind.Description, Mode=OneWay}"
                                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                    <DockPanel Margin="0,8,0,0"
                                               Visibility="{Binding ViewModel.HasConsequence, Converter={StaticResource BoolToVisibility}}">
                                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" FontSize="16" Margin="0,0,8,0"
                                                       VerticalAlignment="Top" Foreground="{DynamicResource Aquila.Chrome.Caution}"/>
                                        <TextBlock Text="{Binding ViewModel.Consequence}" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- The readings: one row each, drawn in the ramp the reading is shown in, with its live value
                             and the way to take it out. A reading is added from a list that appears when asked for, so
                             no list of two hundred sensors stands in the panel the rest of the time. -->
                        <StackPanel Margin="0,20,0,0"
                                    Visibility="{Binding ViewModel.ShowsReadings, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Margin="0"
                                           Text="{Binding ViewModel.ReadingsCount}"/>
                                <TextBlock Text="Readings" Style="{StaticResource FieldLabel}" Margin="0"/>
                            </DockPanel>

                            <Border Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.Chosen.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ItemsControl ItemsSource="{Binding ViewModel.Chosen}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="44" Margin="12,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- The ramp the reading is DRAWN in under this preset (ShownItem), not
                                                     the name it stored — see SeriesRow.ShownItem. -->
                                                <UniformGrid Grid.Column="0" Rows="1" Height="10" VerticalAlignment="Center">
                                                    <Border Background="{Binding ShownItem.Normal}"/>
                                                    <Border Background="{Binding ShownItem.Elevated}"/>
                                                    <Border Background="{Binding ShownItem.Alert}"/>
                                                    <Border Background="{Binding ShownItem.Critical}"/>
                                                </UniformGrid>
                                                <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Sensor.Name, Mode=OneWay}"/><Run
                                                         Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run
                                                         Text="{Binding Sensor.Component, Mode=OneWay}"
                                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.8"
                                                           Typography.NumeralAlignment="Tabular">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F1} {1}">
                                                            <Binding Path="Sensor.Sensor.Value" FallbackValue="--" TargetNullValue="--"/>
                                                            <Binding Path="Sensor.Sensor.Unit"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <ui:Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28"
                                                           Margin="8,0,0,0" Appearance="Transparent" BorderThickness="0"
                                                           Icon="{ui:SymbolIcon Dismiss24}"
                                                           ToolTip="Remove this reading" AutomationProperties.Name="Remove this reading"
                                                           Command="{Binding DataContext.ViewModel.RemoveSeriesCommand,
                                                                     RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <Border Style="{StaticResource Card}"
                                    Visibility="{Binding ViewModel.ShowsNoReadings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                           Text="No readings yet. Add one and the widget appears."/>
                            </Border>

                            <Button x:Name="ReadingButton" Style="{StaticResource GhostButton}" Height="36" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Click="OnReadingButton"
                                    Visibility="{Binding ViewModel.ShowsReadingButton, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ViewModel.ReadingButtonLabel}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{Binding ViewModel.ReadingsFullHint}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Popup x:Name="ReadingPopup" PlacementTarget="{Binding ElementName=ReadingButton}"
                                   Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True"
                                   Width="{Binding ActualWidth, ElementName=ReadingButton}">
                                <controls:SensorPicker x:Name="ReadingPicker" MaxHeight="404"/>
                            </Popup>
                        </StackPanel>

                        <!-- A List ranks applications, so it is given its source instead of readings: one of three,
                             chosen in place. -->
                        <StackPanel Margin="0,20,0,0"
                                    Visibility="{Binding ViewModel.ShowsList, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Ranked by" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="4">
                                <ItemsControl ItemsSource="{Binding ViewModel.RankedChoices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:MenuToggle Style="{StaticResource Segment}" Content="{Binding Option.Name}"
                                                                 IsChecked="{Binding IsChosen, Mode=OneWay}"
                                                                 Command="{Binding DataContext.ViewModel.RankByCommand,
                                                                           RelativeSource={RelativeSource AncestorType=Window}}"
                                                                 CommandParameter="{Binding Option}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="I/O counts files, network and devices together, not just the disk."/>
                            <Grid Margin="0,12,0,0">
                                <Border CornerRadius="6" Opacity="0.12" Background="{DynamicResource Aquila.Chrome.Accent}"/>
                                <Border CornerRadius="6" BorderThickness="1" Opacity="0.35"
                                        BorderBrush="{DynamicResource Aquila.Chrome.Accent}"/>
                                <DockPanel Margin="12,10">
                                    <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,1,10,0"
                                                   VerticalAlignment="Top" Foreground="{DynamicResource Aquila.Chrome.Accent}"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Text="Aquila reads the running applications only while a list is on screen."/>
                                </DockPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <ui:TextBox PlaceholderText="Defaults to the sensor name"
                                        Text="{Binding ViewModel.Title, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- The words of a Text widget are what it says, so they are content like its title. -->
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Visibility="{Binding ViewModel.ShowsCaptionOptions, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Text" Style="{StaticResource FieldLabel}"/>
                                <ui:TextBox PlaceholderText="CPU"
                                            Text="{Binding ViewModel.Caption, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,4,0,0" FontSize="11"
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Text="Add a reading above and it is written after this, with its unit."/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Preset: what it wears, and which ramp draws each of its readings. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ViewModel.SelectedTab, Converter={StaticResource Match}, ConverterParameter=Preset}">
                    <StackPanel Margin="2,16,6,16">
                        <!-- Every preset as a row: its primary ramp, its name, a padlock on the built-ins, how many
                             widgets wear it. A click wears it. A preset is deleted or exported from its own row's ⋯,
                             so tidying away an old one never means wearing it first. -->
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Opacity="0.7">
                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Built in" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Preset" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding ViewModel.PresetRows}"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      KeyboardNavigation.TabNavigation="Once">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:MenuToggle Style="{StaticResource PresetRowStyle}"
                                                         IsChecked="{Binding IsChosen, Mode=OneWay}"
                                                         Command="{Binding DataContext.ViewModel.ChoosePresetCommand,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                                         CommandParameter="{Binding Preset}">
                                        <DockPanel>
                                            <UniformGrid DockPanel.Dock="Left" Rows="1" Width="44" Height="10"
                                                         VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border Background="{Binding Strip.Normal}"/>
                                                <Border Background="{Binding Strip.Elevated}"/>
                                                <Border Background="{Binding Strip.Alert}"/>
                                                <Border Background="{Binding Strip.Critical}"/>
                                            </UniformGrid>
                                            <ui:Button x:Name="More" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                       Width="28" Height="28" Margin="6,0,0,0" Visibility="Hidden"
                                                       Appearance="Transparent" BorderThickness="0"
                                                       Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="More" AutomationProperties.Name="More"
                                                       ContextMenu="{StaticResource PresetRowMenu}"
                                                       Click="OnPresetRowMenu"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Worn}" FontSize="12"
                                                       Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Checkmark24" FontSize="14"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding IsChosen, Converter={StaticResource BoolToVisibility}}"/>
                                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="LockClosed24" FontSize="12"
                                                           Opacity="0.55" VerticalAlignment="Center" Margin="8,0,0,0"
                                                           Visibility="{Binding Preset.IsBuiltIn, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding Preset.Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </controls:MenuToggle>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver,
                                                     RelativeSource={RelativeSource AncestorType=controls:MenuToggle}}"
                                                     Value="True">
                                            <Setter TargetName="More" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- What can be done with the preset worn: a preset of the user's is opened as it is, with
                             a square button beside it for a copy; a built-in is copied first, and the copy opened. -->
                        <DockPanel Margin="0,8,0,0"
                                   Visibility="{Binding ViewModel.CanUpdatePreset, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                       Width="36" Height="36"
                                       Icon="{ui:SymbolIcon Copy24}"
                                       ToolTip="New preset from this one" AutomationProperties.Name="New preset from this one"
                                       Command="{Binding ViewModel.NewPresetCommand}"/>
                            <ui:Button HorizontalAlignment="Stretch" Height="36" Icon="{ui:SymbolIcon Edit24}"
                                       Content="{Binding ViewModel.EditPresetLabel}"
                                       Command="{Binding ViewModel.EditPresetCommand}"/>
                        </DockPanel>
                        <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Height="36"
                                   Icon="{ui:SymbolIcon Copy24}" Content="Copy to edit"
                                   Command="{Binding ViewModel.CopyToEditCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.CanUpdatePreset}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{Binding ViewModel.PresetNote}"/>

                        <DockPanel Margin="0,10,0,0">
                            <!-- Reading a preset in is about the list, not about the preset worn, so it sits here
                                 rather than in a row's menu. -->
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon ArrowUpload24}" Content="Import…"
                                       ToolTip="Import a preset from a file"
                                       Click="OnImportPreset"/>
                            <ui:Button HorizontalAlignment="Left" Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Star24}"
                                       Content="{Binding ViewModel.DefaultLabel}"
                                       IsEnabled="{Binding ViewModel.CanSetDefault}"
                                       Command="{Binding ViewModel.SetAsDefaultCommand}"/>
                        </DockPanel>

                        <!-- Which ramp draws each reading of THIS widget — here, beside the preset its options
                             come from, rather than with the readings, a tab away from the ramps it names. Choosing a
                             ramp is a question about how a reading LOOKS.

                             In the widget's tabs and NEVER in the preset view, because of where it is stored: on
                             the widget's own reading (WidgetSeries.Ramp), not in the preset. The edit view
                             changes the preset every widget wearing it shares; this changes one widget. And it
                             is why trying another preset keeps these choices — they travel by name, and a
                             name the new preset does not have falls back to its primary.

                             Each row names a RAMP, not a colour: which colour it shows depends on how the
                             reading is doing. Two readings on one ramp are one reading, which is why they start
                             on different ones.

                             "Drawn in" rather than "Colour", and that is not fussiness: the format calls these
                             ramps precisely so the word colour stays free for the fixed kind — a theme's, a
                             caption's, value.color. A phrase names the RELATIONSHIP and borrows no noun that
                             already has an owner. Scheme and Palette were out for the same reason:
                             Aquila.Scheme.* and the theme palette are both taken.

                             Hidden for a widget with no readings — a clock or a backdrop has nothing to draw
                             in anything. -->
                        <StackPanel Margin="0,20,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.Chosen.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Each reading drawn in" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Card}" Padding="12,2">
                            <ItemsControl ItemsSource="{Binding ViewModel.Chosen}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Sensor.Name, Mode=OneWay}"/><Run
                                                     Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}"/><Run
                                                     Text="{Binding Sensor.Component, Mode=OneWay}"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </TextBlock>
                                            <!-- The ramp is SHOWN, not named: four swatches say "this
                                                 changes with the reading" without anybody being told, and
                                                 teach the word instead of replacing it. The same strip the
                                                 summary above draws, so a ramp looks like itself wherever
                                                 you meet it.

                                                 Bound to ShownItem — the ramp the reading is actually drawn in
                                                 under this preset, as an ITEM of the list. Two wrong bindings
                                                 came before it, and SeriesRow.ShownItem tells both stories:
                                                 by the stored name it came up empty when the preset lacked the
                                                 name, and by any name at all it came up empty after every switch,
                                                 because "primary" before and "primary" after looked like no
                                                 change to WPF and it never re-selected in the new list. -->
                                            <ComboBox Grid.Column="2" VerticalAlignment="Center"
                                                      ItemsSource="{Binding DataContext.ViewModel.RampPreviews,
                                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding ShownItem}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <UniformGrid Rows="1" Width="34" Height="10"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Border Background="{Binding Normal}"/>
                                                                <Border Background="{Binding Elevated}"/>
                                                                <Border Background="{Binding Alert}"/>
                                                                <Border Background="{Binding Critical}"/>
                                                            </UniformGrid>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>

                            <ui:Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                       Appearance="Transparent" BorderThickness="0"
                                       Icon="{ui:SymbolIcon Drop24}"
                                       Content="Same ramp for all"
                                       ToolTip="Gives every reading the ramp of the first one."
                                       Visibility="{Binding ViewModel.CanMatchRamps, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding ViewModel.MatchRampsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Customize: the rest of how this one widget is drawn and where — its kind's own options, what is
                     shown of its reading, its place, size and layer. Each section only where it applies, by the
                     catalog's flags: a kind that is not a clock cannot be shown clock options. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding ViewModel.SelectedTab, Converter={StaticResource Match}, ConverterParameter=Customize}">
                    <StackPanel Margin="2,16,12,16">
                        <!-- First of the kind's options, because it is about the shape the widget takes:
                             having picked bars, the next thing to say is which way they run. -->
                        <ui:CardControl Style="{StaticResource Row}" Margin="0,0,0,16" Header="Bars run"
                                        Icon="{ui:SymbolIcon ArrowSwap24}"
                                        Visibility="{Binding ViewModel.ShowsDirection, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.BarDirections}"
                                      SelectedItem="{Binding ViewModel.BarDirection}"/>
                        </ui:CardControl>

                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ViewModel.ShowsClockOptions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Clock" Style="{StaticResource Section}"/>
                            <!-- Rings first, because they decide which of the rows below applies: without
                                 rings a clock writes one of the formats, with them the time is always in
                                 the middle and the choice is what goes with it. -->
                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Circle24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Rings"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Coloured by the preset's primary ramp."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.RingChoices}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewModel.SelectedRings}"/>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Header="Shows" Icon="{ui:SymbolIcon Clock24}"
                                            Visibility="{Binding ViewModel.ShowsClockFormat, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.ClockFormats}"
                                          SelectedItem="{Binding ViewModel.SelectedClockFormat}"/>
                            </ui:CardControl>

                            <StackPanel Visibility="{Binding ViewModel.ShowsRingOptions, Converter={StaticResource BoolToVisibility}}">
                                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon CalendarLtr24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show the date"/>
                                            <TextBlock Style="{StaticResource SettingHint}"
                                                       Text="Above the time, in this machine's own format."/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Show the date"
                                                     IsChecked="{Binding ViewModel.DateShown}"/>
                                </ui:CardControl>
                                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Show the seconds"/>
                                            <TextBlock Style="{StaticResource SettingHint}" Text="Below the time."/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Show the seconds"
                                                     IsChecked="{Binding ViewModel.SecondsShown}"/>
                                </ui:CardControl>
                                <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon TextFontSize24}">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="Text fills the rings"/>
                                            <TextBlock Style="{StaticResource SettingHint}"
                                                       Text="Off, the text takes the preset's reading size."/>
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch AutomationProperties.Name="Text fills the rings"
                                                     IsChecked="{Binding ViewModel.TextFillsRings}"/>
                                </ui:CardControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- How much data a chart shows, and against what scale. Both are questions about the
                             readings rather than about the look, so they stay with the widget. -->
                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ViewModel.ShowsChartData, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Chart" Style="{StaticResource Section}"/>
                            <!-- The one slider that keeps the card's width: 20 to 600 in steps of ten is too fine
                                 for the short one a row has room for. -->
                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Timer24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldValue}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Text="{Binding ViewModel.WindowLabel}"/>
                                            <TextBlock Text="Time window"/>
                                        </DockPanel>
                                        <Slider Margin="0,6,0,0" Minimum="20" Maximum="600" TickFrequency="10"
                                                IsSnapToTickEnabled="True" AutomationProperties.Name="Time window"
                                                Value="{Binding ViewModel.PointCount}"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Only the sensors this widget draws keep a longer history. A widened window fills from the right."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowAutofitHeight24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Scale"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="From zero keeps widgets comparable. Fit to data uses the full height, but the scale moves."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Scales}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ViewModel.SelectedScale}"/>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Ruler24}"
                                            Visibility="{Binding ViewModel.ScaleIsManual, Converter={StaticResource BoolToVisibility}}">
                                <ui:CardControl.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Min" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Max" Style="{StaticResource FieldLabel}"/>
                                        <ui:NumberBox Grid.Row="1" Grid.Column="0" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                      Value="{Binding ViewModel.ScaleMin, Mode=TwoWay}"/>
                                        <ui:NumberBox Grid.Row="1" Grid.Column="2" MaxDecimalPlaces="0" ClearButtonEnabled="False"
                                                      Value="{Binding ViewModel.ScaleMax, Mode=TwoWay}"/>
                                    </Grid>
                                </ui:CardControl.Header>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Pulse24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Dot on the latest reading"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="In the reading's colour. It pulses as each reading arrives, while motion is on."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Dot on the latest reading"
                                                 IsChecked="{Binding ViewModel.EndShown}"/>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ColorLine24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Colour by reading"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Each stretch of the line in its reading's colour: amber where it was elevated, red where it was critical. Only for readings with limits."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Colour by reading"
                                                 IsChecked="{Binding ViewModel.ColouredByReading}"/>
                            </ui:CardControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ViewModel.ShowsList, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="List" Style="{StaticResource Section}"/>
                            <!-- How many of a list's rows are shown, under the list it counts. With the widget
                                 and not in the preset, like a chart's window: it decides how much of the data is
                                 on the screen, not how the data looks. -->
                            <ui:CardControl Style="{StaticResource Row}" Header="Rows" Icon="{ui:SymbolIcon TextBulletListLtr24}">
                                <controls:SliderField Minimum="1" Maximum="{Binding ViewModel.MaxItemCount}" Step="1"
                                                      Value="{Binding ViewModel.ItemCount}"/>
                            </ui:CardControl>

                            <!-- What each row draws besides its name and number, and the total. Here for
                                 the same reason as the count: they are things to read, and trying on a
                                 preset must never take one away. How they look is the preset's. -->
                            <ui:CardControl Style="{StaticResource Row}" Header="Bar under each row"
                                            Icon="{ui:SymbolIcon DataBarHorizontal24}">
                                <ui:ToggleSwitch AutomationProperties.Name="Bar under each row"
                                                 IsChecked="{Binding ViewModel.BarShown}"/>
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource Row}" Header="Trend beside each reading"
                                            Icon="{ui:SymbolIcon DataTrending24}">
                                <ui:ToggleSwitch AutomationProperties.Name="Trend beside each reading"
                                                 IsChecked="{Binding ViewModel.SparklineShown}"/>
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource Row}" Header="Total beside the title"
                                            Icon="{ui:SymbolIcon NumberSymbol24}">
                                <ui:ToggleSwitch AutomationProperties.Name="Total beside the title"
                                                 IsChecked="{Binding ViewModel.TotalShown}"/>
                            </ui:CardControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ViewModel.ShowsNumber, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Number" Style="{StaticResource Section}"/>
                            <!-- What a Number draws besides its reading. With the widget, as a list's parts are:
                                 each is something to read, and trying on a preset must never take one away. The
                                 bar is the list's own option, BarShown. -->
                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon DataBarHorizontal24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Level bar under the number"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Only for readings with limits, like temperatures and loads."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Level bar under the number"
                                                 IsChecked="{Binding ViewModel.BarShown}"/>
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource Row}" Header="Session's lowest and highest"
                                            Icon="{ui:SymbolIcon ArrowSortDownLines24}">
                                <ui:ToggleSwitch AutomationProperties.Name="Session's lowest and highest"
                                                 IsChecked="{Binding ViewModel.MinMaxShown}"/>
                            </ui:CardControl>
                            <ui:CardControl Style="{StaticResource Row}" Header="Trend arrow"
                                            Icon="{ui:SymbolIcon ArrowTrending24}">
                                <ui:ToggleSwitch AutomationProperties.Name="Trend arrow"
                                                 IsChecked="{Binding ViewModel.TrendShown}"/>
                            </ui:CardControl>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,16"
                                    Visibility="{Binding ViewModel.ShowsDisplay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Display" Style="{StaticResource Section}"/>
                            <!-- What is shown of the reading, beside the readings themselves. Not in the
                                 preset: a preset has to be safe to try on, and these two change what is on
                                 the screen rather than how it looks. -->
                            <ui:CardControl Style="{StaticResource Row}" Header="Show the unit"
                                            Icon="{ui:SymbolIcon TextNumberFormat24}"
                                            Visibility="{Binding ViewModel.ShowsUnit, Converter={StaticResource BoolToVisibility}}">
                                <ui:ToggleSwitch AutomationProperties.Name="Show the unit"
                                                 IsChecked="{Binding ViewModel.UnitShown}"/>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Eye24}"
                                            Visibility="{Binding ViewModel.CanHideValue, Converter={StaticResource BoolToVisibility}}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Show the reading"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Off leaves the dial or bar drawing on its own, with the title above it."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Show the reading"
                                                 IsChecked="{Binding ViewModel.ValueShown}"/>
                            </ui:CardControl>

                            <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon LineDashes24}"
                                            Visibility="{Binding ViewModel.ShowsLimits, Converter={StaticResource BoolToVisibility}}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Show limits"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Lines on a chart, marks on a bar, where the reading turns elevated and alert. Only for readings with limits."/>
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Show limits"
                                                 IsChecked="{Binding ViewModel.LimitsShown}"/>
                            </ui:CardControl>
                        </StackPanel>

                        <!-- Where it sits and how big it is, in exact numbers. Dragging and the wheel are the
                             quick way; these are for lining widgets up deliberately, and for fetching one back
                             when it has ended up somewhere off-screen. Two by two in one card, because a number
                             box needs more room than the right of a row has. -->
                        <TextBlock Text="Position and size" Style="{StaticResource Section}"/>

                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon ArrowMove24}">
                            <ui:CardControl.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}"/>
                                    <ui:NumberBox Grid.Row="1" Grid.Column="0" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                                  Value="{Binding ViewModel.WidgetX, Mode=TwoWay}"/>
                                    <ui:NumberBox Grid.Row="1" Grid.Column="2" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                                  Value="{Binding ViewModel.WidgetY, Mode=TwoWay}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Width" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Height" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                                    <!-- Free by default, every kind alike. The lock keeps the ratio the widget has:
                                         typing either box sets the other, and the desktop's corners keep it too. The
                                         range is the view model's, which holds both sides inside it. -->
                                    <ui:NumberBox Grid.Row="3" Grid.Column="0" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                                  Minimum="{Binding ViewModel.LeastSize}" Maximum="{Binding ViewModel.MostSize}"
                                                  Value="{Binding ViewModel.WidgetWidth, Mode=TwoWay}"/>
                                    <ToggleButton Grid.Row="3" Grid.Column="1" Margin="6,0" Padding="7,0"
                                                  VerticalAlignment="Stretch"
                                                  ToolTip="Keep proportions. On the desktop, hold Shift while pulling a corner to keep them for that drag." AutomationProperties.Name="Keep proportions. On the desktop, hold Shift while pulling a corner to keep them for that drag."
                                                  IsChecked="{Binding ViewModel.KeepsProportions, Mode=TwoWay}">
                                        <ToggleButton.Style>
                                            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                <Setter Property="Content">
                                                    <Setter.Value>
                                                        <ui:SymbolIcon Symbol="LockOpen24" FontSize="16"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content">
                                                            <Setter.Value>
                                                                <ui:SymbolIcon Symbol="LockClosed24" FontSize="16"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ui:NumberBox Grid.Row="3" Grid.Column="2" MaxDecimalPlaces="0" SmallChange="1" LargeChange="10"
                                                  Minimum="{Binding ViewModel.LeastSize}" Maximum="{Binding ViewModel.MostSize}"
                                                  Value="{Binding ViewModel.WidgetHeight, Mode=TwoWay}"/>
                                </Grid>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- Which screen it is shown on. Pointing at a name lights up that monitor, as the desktop
                             menu's "Send to" does: a name alone does not say which piece of hardware it is. -->
                        <ui:CardControl Style="{StaticResource Row}" Header="Shown on" Icon="{ui:SymbolIcon Desktop24}">
                            <ComboBox MinWidth="200"
                                      ItemsSource="{Binding ViewModel.Screens}"
                                      SelectedItem="{Binding ViewModel.SelectedScreen}"
                                      DisplayMemberPath="Label"
                                      IsEnabled="{Binding ViewModel.CanChooseScreen}"
                                      DropDownClosed="OnScreenPickerClosed">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <EventSetter Event="MouseEnter" Handler="OnScreenPointed"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Which widget draws on top where two overlap — said in words, with a step each way.
                             A slider from −5 to 10 said a number, and moving it from 0 to 1 could change nothing
                             anyone could see; each press here passes one widget that overlaps this one. -->
                        <ui:CardControl Style="{StaticResource Row}" Icon="{ui:SymbolIcon Layer24}">
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Layer"/>
                                    <TextBlock Style="{StaticResource SettingHint}" Text="{Binding ViewModel.LayerDescription}"/>
                                    <TextBlock Style="{StaticResource SettingHint}"
                                               Text="Where two widgets overlap, the one in front draws on top. A backdrop sits behind everything."/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Style="{StaticResource IconButton}" Margin="0,0,4,0"
                                           Icon="{ui:SymbolIcon PositionBackward24}"
                                           ToolTip="Send backward" AutomationProperties.Name="Send backward"
                                           ToolTipService.ShowOnDisabled="True"
                                           IsEnabled="{Binding ViewModel.CanSendBackward}"
                                           Command="{Binding ViewModel.SendBackwardCommand}"/>
                                <ui:Button Style="{StaticResource IconButton}"
                                           Icon="{ui:SymbolIcon PositionForward24}"
                                           ToolTip="Bring forward" AutomationProperties.Name="Bring forward"
                                           ToolTipService.ShowOnDisabled="True"
                                           IsEnabled="{Binding ViewModel.CanBringForward}"
                                           Command="{Binding ViewModel.BringForwardCommand}"/>
                            </StackPanel>
                        </ui:CardControl>

                        <Grid Margin="0,12,0,0">
                            <Border CornerRadius="6" Opacity="0.12" Background="{DynamicResource Aquila.Chrome.Accent}"/>
                            <Border CornerRadius="6" BorderThickness="1" Opacity="0.35"
                                    BorderBrush="{DynamicResource Aquila.Chrome.Accent}"/>
                            <DockPanel Margin="12,10">
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,1,10,0"
                                               VerticalAlignment="Top" Foreground="{DynamicResource Aquila.Chrome.Accent}"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Text="On the desktop: drag to move it, pull a corner to resize it — hold Shift to keep its shape — or use the mouse wheel."/>
                            </DockPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- The same row, so the two views occupy the same space and only one is ever shown. Cheaper
                 than moving anything, and it keeps the header and the footer where they were. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ViewModel.ShowsPresetView, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="2,0,12,0" Expander.Expanded="OnCardExpanded">

                    <!-- How far an edit here reaches, said before anything is touched, on a wash of the accent: this
                         is the one place in the panel where a change is not this widget's alone. No preview here:
                         it paints the whole desktop, so it is the edit bar's. -->
                    <Grid Margin="0,4,0,12">
                        <Border CornerRadius="6" Opacity="0.12" Background="{DynamicResource Aquila.Chrome.Accent}"/>
                        <Border CornerRadius="6" BorderThickness="1" Opacity="0.35"
                                BorderBrush="{DynamicResource Aquila.Chrome.Accent}"/>
                        <DockPanel Margin="12,10">
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" FontSize="16" Margin="0,1,10,0"
                                           VerticalAlignment="Top" Foreground="{DynamicResource Aquila.Chrome.Accent}"/>
                            <TextBlock Text="{Binding ViewModel.PresetReach}" FontSize="12" TextWrapping="Wrap"/>
                        </DockPanel>
                    </Grid>
                    <ui:CardExpander Icon="{ui:SymbolIcon SquareHint24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Panel" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Background" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.BackgroundColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.BackgroundOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Border">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.BorderColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.BorderOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Border thickness">
                                <controls:SliderField Minimum="0" Maximum="4" Step="1" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.BorderThickness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Corners">
                                <controls:SliderField Minimum="0" Maximum="24" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.CornerRadius}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Padding">
                                <controls:SliderField Minimum="0" Maximum="32" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.Padding}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon Drop24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Ramps" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel Margin="0,12,0,0">
                        <!-- Every ramp at once. A picker showing one at a time hid the thing worth seeing: the second ramp
                             is chosen against the first, and side by side you can tell whether they belong together. -->
                        <ItemsControl ItemsSource="{Binding ViewModel.RampRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <DockPanel Margin="0,0,0,8">
                                            <!-- Everything that acts on this one ramp, behind the same button as
                                                 everything that acts on the preset. Removing was a bare bin icon that
                                                 appeared and vanished with CanDelete, so primary's row was a different
                                                 shape from the others for a reason you could only infer. -->
                                            <ui:Button Style="{StaticResource IconButton}" DockPanel.Dock="Right" Margin="6,0,0,0"
                                                       Icon="{ui:SymbolIcon MoreHorizontal24}"
                                                       ToolTip="More" AutomationProperties.Name="More"
                                                       Click="OnRampMenu">
                                                <ui:Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Rename" Click="OnRenameRamp"
                                                                  IsEnabled="{Binding CanRename}">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="Rename24"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator/>
                                                        <MenuItem Header="Remove" Command="{Binding DeleteCommand}"
                                                                  IsEnabled="{Binding CanDelete}">
                                                            <MenuItem.Icon>
                                                                <ui:SymbolIcon Symbol="Delete24"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </ui:Button.ContextMenu>
                                            </ui:Button>

                                            <!-- Not a mode: it writes the same colour into all four stops, which is what a
                                                 colour that never changes already IS in this format. -->
                                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                             IsChecked="{Binding Fixed}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="Fixed colour" Margin="0,0,8,0"
                                                       VerticalAlignment="Center" FontSize="11" Opacity="0.5"/>

                                            <!-- The name is the KEY, not a label: a series points at its ramp by this
                                                 string, so renaming here moves every reference with it.

                                                 Drawn as the row's heading and editable where it stands, exactly as the
                                                 preset's own name is — the same gesture for the same kind of thing. The
                                                 menu's Rename only puts the caret here; it teaches where the name lives
                                                 rather than opening a second place to type it. -->
                                            <TextBox Style="{StaticResource InlineTitle}" FontSize="13" Margin="-6,0,0,0"
                                                     IsEnabled="{Binding CanRename}"
                                                     ToolTip="Click to rename. Enter to keep it, Escape to put it back."
                                                     KeyDown="OnNameKey"
                                                     Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                        </DockPanel>

                                        <UniformGrid Rows="1"
                                                     Visibility="{Binding Varies, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Margin="0,0,6,0">
                                            <controls:ColorField Height="30" HorizontalAlignment="Stretch"
                                                                 Color="{Binding Normal, Mode=TwoWay}"
                                                                 Swatches="{Binding DataContext.ViewModel.Swatches,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock Text="NORMAL" FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <controls:ColorField Height="30" HorizontalAlignment="Stretch"
                                                                 Color="{Binding Elevated, Mode=TwoWay}"
                                                                 Swatches="{Binding DataContext.ViewModel.Swatches,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock Text="ELEVATED" FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,6,0">
                                            <controls:ColorField Height="30" HorizontalAlignment="Stretch"
                                                                 Color="{Binding Alert, Mode=TwoWay}"
                                                                 Swatches="{Binding DataContext.ViewModel.Swatches,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock Text="ALERT" FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0">
                                            <controls:ColorField Height="30" HorizontalAlignment="Stretch"
                                                                 Color="{Binding Critical, Mode=TwoWay}"
                                                                 Swatches="{Binding DataContext.ViewModel.Swatches,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock Text="CRITICAL" FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        </UniformGrid>

                                        <StackPanel Visibility="{Binding Fixed, Converter={StaticResource BoolToVisibility}}">
                                            <controls:ColorField Height="30" HorizontalAlignment="Stretch"
                                                                 Color="{Binding Normal, Mode=TwoWay}"
                                                                 Swatches="{Binding DataContext.ViewModel.Swatches,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                            <TextBlock Text="EVERY STATE" FontSize="10" Opacity="0.5" Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                                Command="{Binding ViewModel.AddRampCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Add ramp" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </ui:CardExpander>


                    <!-- A clock's rings are arcs too, and take everything here but the sweep. -->
                    <ui:CardExpander Icon="{ui:SymbolIcon Gauge24}"
                                         Visibility="{Binding ViewModel.ShowsArc, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Dial" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Arc thickness" BorderThickness="0">
                                <controls:SliderField Minimum="2" Maximum="40" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.ArcThickness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Arc ends">
                                <controls:SliderField Minimum="0" Maximum="20" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.ArcCorner}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Sweep"
                                                    Visibility="{Binding ViewModel.ShowsDial, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Sweeps}"
                                          SelectedItem="{Binding ViewModel.Sweep}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Track">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.TrackColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.TrackOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon DataLine24}"
                                         Visibility="{Binding ViewModel.ShowsLine, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Line" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Thickness" BorderThickness="0">
                                <controls:SliderField Minimum="0.5" Maximum="6" Format="{}{0:F1} px"
                                                      Value="{Binding ViewModel.LineThickness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Fill">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Fills}"
                                          SelectedItem="{Binding ViewModel.LineFill}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Fill opacity">
                                <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                      Value="{Binding ViewModel.FillOpacity}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Smoothness">
                                <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                      Value="{Binding ViewModel.Smoothness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Points">
                                <controls:SliderField Minimum="0" Maximum="10" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.PointSize}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon DataBarHorizontal24}"
                                         Visibility="{Binding ViewModel.ShowsBarStyle, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Bar" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Thickness" BorderThickness="0">
                                <controls:SliderField Minimum="2" Maximum="40" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.BarThickness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Corners">
                                <controls:SliderField Minimum="0" Maximum="20" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.BarCorner}"/>
                            </HeaderedContentControl>
                            <!-- A list's row bar is always under its line, so only the bar kinds are asked. -->
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Layout"
                                                    Visibility="{Binding ViewModel.ShowsBar, Converter={StaticResource BoolToVisibility}}">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Layouts}"
                                          SelectedItem="{Binding ViewModel.BarLayout}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon NumberSymbol24}"
                                         Visibility="{Binding ViewModel.ShowsNumber, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Number" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Unit size" BorderThickness="0">
                                <controls:SliderField Minimum="6" Maximum="24" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.UnitSize}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Unit opacity">
                                <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                      Value="{Binding ViewModel.UnitOpacity}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon TextT24}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Title" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Colour" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.TitleColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.TitleOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Typeface">
                                <ComboBox Width="200" ItemsSource="{Binding ViewModel.FontFamilies}"
                                          SelectedItem="{Binding ViewModel.TitleFont}">
                                    <!-- Every name set in its own face, so the list is a specimen sheet rather than a
                                         list of words. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Weight">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Weights}"
                                          SelectedItem="{Binding ViewModel.TitleWeight}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Size">
                                <controls:SliderField Minimum="6" Maximum="24" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.TitleSize}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Side">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Placements}"
                                          SelectedItem="{Binding ViewModel.TitlePlacement}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}">
                                <HeaderedContentControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Align"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Applies with the title above or below. Docked to a side it is already as narrow as its text."/>
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Alignments}"
                                          SelectedItem="{Binding ViewModel.TitleAlign}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Distance to content">
                                <controls:SliderField Minimum="0" Maximum="24" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.TitleGap}"/>
                            </HeaderedContentControl>

                            <!-- The title's own box: the panel's controls again, for the line the title sits on. -->
                            <TextBlock Text="Box" Style="{StaticResource Section}" Margin="0,16,0,4"/>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Background" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.TitleBackgroundColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.TitleBackgroundOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Border">
                                <StackPanel Orientation="Horizontal">
                                    <controls:ColorField Color="{Binding ViewModel.TitleBorderColor, Mode=TwoWay}"
                                                         Swatches="{Binding ViewModel.Swatches}"/>
                                    <controls:SliderField Minimum="0" Maximum="100" Format="{}{0:F0}%"
                                                          Value="{Binding ViewModel.TitleBorderOpacity}"/>
                                </StackPanel>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Border thickness">
                                <controls:SliderField Minimum="0" Maximum="4" Step="1" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.TitleBorderThickness}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Corners">
                                <controls:SliderField Minimum="0" Maximum="24" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.TitleCornerRadius}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Padding">
                                <controls:SliderField Minimum="0" Maximum="16" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.TitlePadding}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}">
                                <HeaderedContentControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Reaches the panel's edges"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Past the panel's padding on the outer sides, with the panel's corners there — a title bar."/>
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <ui:ToggleSwitch AutomationProperties.Name="Box reaches the panel's edges"
                                                 IsChecked="{Binding ViewModel.TitleBleed}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>


                    <ui:CardExpander Icon="{ui:SymbolIcon TextNumberFormat24}"
                                         Visibility="{Binding ViewModel.ShowsValue, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <TextBlock Text="Reading" FontWeight="SemiBold"/>
                        </ui:CardExpander.Header>

                        <StackPanel>
                            <HeaderedContentControl Style="{StaticResource Line}" BorderThickness="0">
                                <HeaderedContentControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Colour"/>
                                        <TextBlock Style="{StaticResource SettingHint}"
                                                   Text="Shows where nothing is judging the number — a clock, a caption. A reading with a sensor behind it takes its ramp's colour instead."/>
                                    </StackPanel>
                                </HeaderedContentControl.Header>
                                <controls:ColorField Color="{Binding ViewModel.ValueColor, Mode=TwoWay}"
                                                     Swatches="{Binding ViewModel.Swatches}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Typeface">
                                <ComboBox Width="200" ItemsSource="{Binding ViewModel.FontFamilies}"
                                          SelectedItem="{Binding ViewModel.ValueFont}">
                                    <!-- Every name set in its own face, so the list is a specimen sheet rather than a
                                         list of words. -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Weight">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Weights}"
                                          SelectedItem="{Binding ViewModel.ValueWeight}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Size">
                                <controls:SliderField Minimum="8" Maximum="64" Format="{}{0:F0} px"
                                                      Value="{Binding ViewModel.ValueSize}"/>
                            </HeaderedContentControl>
                            <HeaderedContentControl Style="{StaticResource Line}" Header="Align">
                                <ComboBox MinWidth="160" ItemsSource="{Binding ViewModel.Alignments}"
                                          SelectedItem="{Binding ViewModel.ValueAlign}"/>
                            </HeaderedContentControl>
                        </StackPanel>
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>

            <!-- The keys the panel answers to, written at its foot — the only place they are. Replaced the preset
                 view's Done: the way back is the breadcrumb, and Esc, which this line names. -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding ViewModel.HasTarget, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Divider}" Margin="0,4,0,10"
                        Background="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Opacity="0.6">
                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewModel.Footer}" FontSize="12" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
    </Grid>
</ui:FluentWindow>
