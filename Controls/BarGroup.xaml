<UserControl x:Class="Aquila.Controls.BarGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="260" d:DesignHeight="110">
    <!-- N independent vertical bars side by side (e.g. CPU per-core load). The columns are built in code, once per
         bar, and kept from reading to reading — see BarGroup.xaml.cs. -->
    <UniformGrid x:Name="Columns" Rows="1"/>
</UserControl>
