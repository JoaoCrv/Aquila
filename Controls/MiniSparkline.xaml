<UserControl x:Class="Aquila.Controls.MiniSparkline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Aquila.Controls"
             mc:Ignorable="d"
             d:DesignHeight="64" d:DesignWidth="160">
    <!-- Live sparkline for one sensor: the line is Sensor.History, the number is Sensor.Value.
         A thin wrapper over SparklineChart so the dashboard and desktop widgets share one piece
         (sibling of RadialGauge — both take a live SensorNode). -->
    <Grid>
        <controls:SparklineChart x:Name="Spark"/>
        <TextBlock x:Name="ValueText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="0,2,4,0"/>
    </Grid>
</UserControl>
