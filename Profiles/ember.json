{
  "id": "ember",
  "name": "Ember",
  "author": "Aquila",
  "description": "Aquila's own profile, drawn from the logo. Warm and monochrome: colour measures how hot something is rather than naming which component it is — the icon already does that.",



  "palette": {
    "dark":  [ "#FFD9A8", "#FFB765", "#F5A623", "#FF6B35", "#DA3B01" ],
    "light": [ "#B24500", "#CA5010", "#DA3B01", "#E85D04", "#9A2C00" ]
  },

  "roles": {
    "accent": 3,
    "normal": 2,
    "elevated": 3,
    "alert": 4,
    "critical": 5,

    // Series stay off steps 4 and 5, which alert and critical own. On a monochrome
    // ramp a series that borrows the alarm colour reads as an alarm — a second GPU
    // drawing 16 W should not look like a fault.
    "series1": 3,
    "series2": 1,
    "series3": 2,

    "track": { "step": 3, "opacity": 0.13 }
  }
}
