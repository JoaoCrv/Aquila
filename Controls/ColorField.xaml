<UserControl x:Class="Aquila.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid>
        <!-- The closed state is the colour itself. Nothing else is needed to say "this is a colour and you
             may change it" — the same reasoning as the preset name that only shows its edges on hover. -->
        <!-- Sized by whoever places it, with a floor rather than a fixed size: a stop in a ramp is a wide
             block, a colour beside a label is a small square, and both are this control. -->
        <Border x:Name="Swatch" MinWidth="24" MinHeight="24" CornerRadius="4"
                BorderThickness="1" Cursor="Hand"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                MouseLeftButtonUp="OnOpen"/>

        <Popup x:Name="Picker" StaysOpen="False" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade">
            <Border Padding="12" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                <StackPanel Width="212">

                    <!-- Saturation across, brightness down, over the chosen hue. Three stacked brushes and
                         no drawing code: white-to-hue, then transparent-to-black on top of it. -->
                    <Grid x:Name="Field" Height="120" Cursor="Cross"
                          MouseLeftButtonDown="OnFieldDown" MouseMove="OnFieldMove"
                          MouseLeftButtonUp="OnRelease">
                        <Border x:Name="FieldHue" CornerRadius="4"/>
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000"/>
                                    <GradientStop Offset="1" Color="#FF000000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas ClipToBounds="True">
                            <Ellipse x:Name="Crosshair" Width="12" Height="12" StrokeThickness="2"
                                     Stroke="White" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>

                    <Grid x:Name="Hue" Height="16" Margin="0,10,0,0" Cursor="Cross"
                          MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove"
                          MouseLeftButtonUp="OnRelease">
                        <Border CornerRadius="4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0.00" Color="#FF0000"/>
                                    <GradientStop Offset="0.17" Color="#FFFF00"/>
                                    <GradientStop Offset="0.33" Color="#00FF00"/>
                                    <GradientStop Offset="0.50" Color="#00FFFF"/>
                                    <GradientStop Offset="0.67" Color="#0000FF"/>
                                    <GradientStop Offset="0.83" Color="#FF00FF"/>
                                    <GradientStop Offset="1.00" Color="#FF0000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas ClipToBounds="True">
                            <Rectangle x:Name="HueMark" Width="4" Height="16" RadiusX="2" RadiusY="2"
                                       Stroke="White" StrokeThickness="2" IsHitTestVisible="False"/>
                        </Canvas>
                    </Grid>

                    <!-- Kept, not replaced. Someone handed a hex by a designer should be able to paste it,
                         and it is the only way to say a colour exactly. -->
                    <TextBox x:Name="Hex" Margin="0,10,0,0" Padding="6,4" FontFamily="Consolas"
                             KeyDown="OnHexKey" LostFocus="OnHexCommitted"/>

                    <!-- The preset's own colours first, so building a second ramp that belongs with the
                         first is a click rather than a matching exercise. -->
                    <ItemsControl x:Name="SwatchList" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="20" Height="20" CornerRadius="3" Margin="0,0,4,4"
                                        Cursor="Hand" BorderThickness="1"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{Binding}"
                                        ToolTip="{Binding}"
                                        MouseLeftButtonDown="OnSwatchPicked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
