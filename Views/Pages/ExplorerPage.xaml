<Page x:Class="Aquila.Views.Pages.ExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Aquila.Views.Pages"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="Explorer"
      Style="{StaticResource BasePageStyle}"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,12,20,4">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sensors" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock
                    Text="Live sensors monitored by Aquila, grouped by component"
                    FontSize="12"
                    Opacity="0.6"
                    Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Search bar -->
        <ui:TextBox
            Grid.Row="1"
            Margin="20,4,20,8"
            PlaceholderText="Search sensors..."
            ClearButtonEnabled="True"
            Text="{Binding ViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}">
            <ui:TextBox.Icon>
                <ui:SymbolIcon Symbol="Search24"/>
            </ui:TextBox.Icon>
        </ui:TextBox>

        <!-- Component list -->
        <ItemsControl
            Grid.Row="2"
            ItemsSource="{Binding ViewModel.FilteredComponents}"
            Margin="20,0,20,20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Collapsed by default: a machine reports a lot of components, and opening them all
                         at once buries the list the user is trying to scan. A search opens them, since
                         what survived the filter is what's being looked for. -->
                    <ui:CardExpander Margin="0,0,0,4" CornerRadius="8"
                                     IsExpanded="{Binding DataContext.ViewModel.IsFiltering,
                                                  RelativeSource={RelativeSource AncestorType=Page},
                                                  Mode=OneWay}">
                        <ui:CardExpander.Header>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Opacity="0.6" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} sensors">
                                            <Binding Path="Sensors.Count"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </ui:CardExpander.Header>

                        <ItemsControl ItemsSource="{Binding Sensors}" Margin="0,8,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,0" MinHeight="36" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid MinHeight="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Text="{Binding Label}"
                                                FontSize="13"
                                                VerticalAlignment="Center"/>
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F1} {1}">
                                                        <Binding Path="Sensor.Value"/>
                                                        <Binding Path="Sensor.Unit"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>
