<Page
    x:Class="Aquila.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Aquila.Controls"
    xmlns:cards="clr-namespace:Aquila.Controls.Cards"
    xmlns:vm="clr-namespace:Aquila.ViewModels.Pages"
    xmlns:nodes="clr-namespace:Aquila.Models.Nodes"
    xmlns:helpers="clr-namespace:Aquila.Helpers"
    Style="{StaticResource BasePageStyle}"
    Title="DashboardPage"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="VerticalAlignment"        Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <helpers:ThroughputConverter x:Key="ThroughputConverter"/>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <helpers:ProgressBarWidthConverter x:Key="ProgressBarWidthConverter"/>
        <helpers:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
        <helpers:ThermalBrushConverter x:Key="ThermalBrushConverter"/>
        <helpers:WidthThresholdConverter x:Key="WidthThresholdConverter"/>

        <!-- Storage card DataTemplate -->
        <DataTemplate x:Key="StorageCardTemplate" DataType="{x:Type nodes:StorageNode}">
            <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: name + stats + I/O rows -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="STORAGE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource ChipName}" Margin="0,0,0,10"
                                   TextTrimming="CharacterEllipsis"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Border Style="{StaticResource StatBox}" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatBoxValue}"
                                               Foreground="{Binding Temperature.Primary.Value, Converter={StaticResource ThermalBrushConverter}}">
                                        <Run Text="{Binding Temperature.Primary.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                                        <Run Text="°C" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Temp" Style="{StaticResource StatBoxLabel}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatBox}" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatBoxValue}">
                                        <Run Text="{Binding Load.UsedSpace.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                                        <Run Text="%" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Used" Style="{StaticResource StatBoxLabel}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Read" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Aquila.Cpu}"
                                       Text="{Binding Throughput.ReadRate.Value, Converter={StaticResource ThroughputConverter}, FallbackValue='--'}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource CpuBar}" Margin="0,2,0,6"
                                     Value="{Binding Throughput.ReadRate.Value, FallbackValue=0}"
                                     Maximum="{Binding Throughput.ReadRate.Max, FallbackValue=1}"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Write" Style="{StaticResource RowLabel}"/>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Aquila.Ram}"
                                       Text="{Binding Throughput.WriteRate.Value, Converter={StaticResource ThroughputConverter}, FallbackValue='--'}"/>
                        </Grid>
                        <ProgressBar Style="{StaticResource RamBar}" Margin="0,2,0,6"
                                     Value="{Binding Throughput.WriteRate.Value, FallbackValue=0}"
                                     Maximum="{Binding Throughput.WriteRate.Max, FallbackValue=1}"/>
                        <TextBlock Text="I/O ° 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                                   Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThresholdConverter}, ConverterParameter=280}"/>
                    </StackPanel>

                    <!-- Row 1: sparkline fills remaining space -->
                    <controls:SparklineChart Grid.Row="1" MinHeight="40"
                        Values="{Binding Throughput.ReadRate.History}"
                        SeriesColor="{DynamicResource Aquila.Chart.Cpu}"
                        SecondValues="{Binding Throughput.WriteRate.History}"
                        SecondColor="{DynamicResource Aquila.Chart.Ram}"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThresholdConverter}, ConverterParameter=280}"/>
                </Grid>
            </ui:Card>
        </DataTemplate>

        <!-- GPU card DataTemplate -->
    </Page.Resources>

    <StackPanel>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="5" Padding="10,4" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timer24" FontSize="13" Margin="0,0,5,0" Opacity="0.45"/>
                    <TextBlock Text="{Binding ViewModel.SystemUptime}" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="5" Padding="10,4" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="13" Margin="0,0,5,0" Opacity="0.45"/>
                    <TextBlock Text="{Binding ViewModel.CurrentDateTime}" FontSize="12" Opacity="0.65"/>
                </StackPanel>
            </Border>
            <ui:Button Command="{Binding ViewModel.ToggleDashboardCommand}"
                       ToolTip="{Binding ViewModel.DashboardToggleTooltip}"
                       Appearance="Secondary" Padding="7,4">
                <ui:SymbolIcon Symbol="{Binding ViewModel.DashboardToggleIcon}" FontSize="13"/>
            </ui:Button>
        </StackPanel>

        <controls:ResponsiveCardPanel Gap="8" MinCardWidth="320">

            <!-- ── CPU card ─────────────────────────────────────────── -->
            <cards:CpuCard Cpu="{Binding ViewModel.Hardware.Cpus[0]}"
                           Visibility="{Binding ViewModel.ShowCpuCard}"/>

            <!-- ── GPU cards ─────────────────────────────────────────── -->
            <cards:GpuCard Gpu="{Binding ViewModel.Gpu1}"
                           Visibility="{Binding ViewModel.Gpu1, Converter={StaticResource NullToCollapsedConverter}}"/>
            <cards:GpuCard Gpu="{Binding ViewModel.Gpu2}"
                           Visibility="{Binding ViewModel.Gpu2, Converter={StaticResource NullToCollapsedConverter}}"/>

            <!-- ── RAM card ──────────────────────────────────────────── -->
            <cards:RamCard Memory="{Binding ViewModel.Hardware.Memory}"
                           Visibility="{Binding ViewModel.ShowMemoryCard}"/>

            <!-- ── Network card ──────────────────────────────────────── -->
            <cards:NetworkCard Network="{Binding ViewModel.Hardware.Networks[0]}"
                               Visibility="{Binding ViewModel.ShowNetworkCard}"/>

            <!-- ── Storage cards (one slot per drive) ───────────────── -->
            <ContentControl Content="{Binding ViewModel.Storage1}"
                            ContentTemplate="{StaticResource StorageCardTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding ViewModel.Storage1, Converter={StaticResource NullToCollapsedConverter}}"/>
            <ContentControl Content="{Binding ViewModel.Storage2}"
                            ContentTemplate="{StaticResource StorageCardTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding ViewModel.Storage2, Converter={StaticResource NullToCollapsedConverter}}"/>
            <ContentControl Content="{Binding ViewModel.Storage3}"
                            ContentTemplate="{StaticResource StorageCardTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding ViewModel.Storage3, Converter={StaticResource NullToCollapsedConverter}}"/>
            <ContentControl Content="{Binding ViewModel.Storage4}"
                            ContentTemplate="{StaticResource StorageCardTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="{Binding ViewModel.Storage4, Converter={StaticResource NullToCollapsedConverter}}"/>

            <!-- ── Temperatures card ─────────────────────────────────── -->
            <cards:TemperaturesCard
                Temperatures="{Binding ViewModel.Hardware.Motherboard.Temperature}"
                DieTemperature="{Binding ViewModel.Hardware.Cpus[0].Temperature.Primary}"
                Visibility="{Binding ViewModel.ShowTemperaturesCard}"/>

            <!-- ── Fans card ─────────────────────────────────────────── -->
            <cards:FansCard FanRows="{Binding ViewModel.FanRows}"
                            CpuFan="{Binding ViewModel.Hardware.Motherboard.CpuFan}"
                            Visibility="{Binding ViewModel.ShowFansCard}"/>

            <!-- ── Power card ────────────────────────────────────────── -->
            <cards:PowerCard
                TotalPower="{Binding ViewModel.Hardware.TotalPower}"
                CpuPower="{Binding ViewModel.Hardware.Cpus[0].Power.Package}"
                Gpu1Power="{Binding ViewModel.Gpu1.Power.Package}"
                Gpu2Power="{Binding ViewModel.Gpu2.Power.Package}"
                Visibility="{Binding ViewModel.ShowPowerCard}"/>

        </controls:ResponsiveCardPanel>

    </StackPanel>

</Page>
