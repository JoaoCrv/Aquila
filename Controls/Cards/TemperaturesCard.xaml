<UserControl x:Class="Aquila.Controls.Cards.TemperaturesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="340">
    <!-- Self-contained temperatures card: a grid of temperature stat boxes plus a trend sparkline.
         Bind Temperatures (the sensors to list) and DieTemperature (the sensor to chart). Every
         value binds straight to the SensorNodes, so no computed state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:IntensityBrushConverter x:Key="Intensity"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="TEMPERATURES" Style="{StaticResource SectionLabel}"/>

                <!-- The only card whose headline number is itself coloured: it is a temperature, so it
                     has a threshold, and colour here says something the number alone does not. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardIconChip}" Margin="0,0,9,0">
                        <ui:SymbolIcon Symbol="Temperature24" FontSize="14"
                                       Foreground="{DynamicResource Aquila.Scheme.Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Thermal sensors" Style="{StaticResource ChipName}"/>
                        <TextBlock Text="CPU die" FontSize="10" Opacity="0.45" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <TextBlock Style="{StaticResource CardBigValue}"
                                   Foreground="{Binding DieTemperature.Value, Converter={StaticResource Intensity}, ConverterParameter='50,70,85'}"
                                   Text="{Binding DieTemperature.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                        <TextBlock Style="{StaticResource CardBigUnit}" Text="°C"/>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Temperatures}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:StatBox Margin="0,0,6,6"
                                Label="{Binding Name}" Unit="°C" UnitSize="14"
                                Value="{Binding Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                                Accent="{Binding Value, Converter={StaticResource Intensity}, ConverterParameter='50,70,85'}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="CPU DIE · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding DieTemperature.History}"
                SeriesColor="{DynamicResource Aquila.Scheme.Series1}"
                MaxY="100"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
