<Window x:Class="Aquila.Views.Windows.WidgetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Widget"
        Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedSensors" Source="{Binding ViewModel.Sensors}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Component"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="3"
                   Text="Add widget" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>

        <!-- Left: the choices -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="1 · Widget" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding ViewModel.Kinds}"
                         SelectedItem="{Binding ViewModel.SelectedKind}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0,0,6,0"/>
                            <Setter Property="Padding" Value="10,8"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.6"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="2 · Data" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,6"/>
                <ui:TextBox PlaceholderText="Search sensors…"
                            Text="{Binding ViewModel.SensorFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <ListBox Margin="0,8,0,0" Height="230"
                         ItemsSource="{Binding Source={StaticResource GroupedSensors}}"
                         SelectedItem="{Binding ViewModel.SelectedSensor}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Opacity="0.6" FontSize="11" Margin="0,8,0,2"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <!-- Live value: names alone are ambiguous when a machine reports a dozen
                                     similar temperatures. -->
                                <TextBlock Grid.Column="1" Opacity="0.6" Margin="12,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F1} {1}">
                                            <Binding Path="Sensor.Value" FallbackValue="--"/>
                                            <Binding Path="Sensor.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <TextBlock Text="3 · Appearance" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0"
                                PlaceholderText="Title (defaults to the sensor name)"
                                Text="{Binding ViewModel.Title, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding ViewModel.Accents}"
                              SelectedItem="{Binding ViewModel.SelectedAccent}"
                              DisplayMemberPath="Name"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Right: live preview on a wallpaper-ish backdrop, since that's where it will live -->
        <StackPanel Grid.Row="1" Grid.Column="2">
            <TextBlock Text="Preview" FontWeight="SemiBold" Opacity="0.75" Margin="0,0,0,6"/>
            <Border CornerRadius="8" Height="260" Padding="16"
                    Background="#2E3B4E">
                <ContentControl Content="{Binding ViewModel.Preview}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Shown exactly as it will appear on the desktop, with live data."
                       FontSize="11" Opacity="0.55" Margin="2,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Cancel" MinWidth="110" Click="Cancel_Click"/>
            <ui:Button x:Name="SaveButton" Content="Save" MinWidth="110" Margin="8,0,0,0"
                       Appearance="Primary" Click="Save_Click"
                       IsEnabled="{Binding ViewModel.CanSave}"/>
        </StackPanel>
    </Grid>
</Window>
