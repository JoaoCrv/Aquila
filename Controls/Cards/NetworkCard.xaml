<UserControl x:Class="Aquila.Controls.Cards.NetworkCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="340">
    <!-- Self-contained network card: bind Network and it renders the whole card. Every value binds
         straight to the SensorNodes, so there is no computed state. Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:ThroughputConverter x:Key="Throughput"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: header + throughput rows -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="NETWORK" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="{Binding Network.Name, FallbackValue='Adapter'}"
                           FontSize="12" FontWeight="Normal" Opacity="0.55"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="↓ Download" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Aquila.Cpu}"
                               Text="{Binding Network.Throughput.Download.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="↑ Upload" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Aquila.Ram}"
                               Text="{Binding Network.Throughput.Upload.Value, Converter={StaticResource Throughput}, FallbackValue='--'}"/>
                </Grid>
                <TextBlock Text="THROUGHPUT · 60s" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Network.Throughput.Download.History}"
                SeriesColor="{DynamicResource Aquila.Chart.NetDown}"
                SecondValues="{Binding Network.Throughput.Upload.History}"
                SecondColor="{DynamicResource Aquila.Chart.NetUp}"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>

            <!-- Row 2: totals (hide when narrow) -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                <Border Style="{StaticResource Divider}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Received" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} {1}" FallbackValue="--">
                                <Binding Path="Network.Data.Downloaded.Value"/>
                                <Binding Path="Network.Data.Downloaded.Unit"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sent" Style="{StaticResource RowLabel}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource RowValue}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} {1}" FallbackValue="--">
                                <Binding Path="Network.Data.Uploaded.Value"/>
                                <Binding Path="Network.Data.Uploaded.Unit"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>
