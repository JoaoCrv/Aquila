<Page x:Class="Aquila.Views.Pages.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:Aquila.Controls"
      xmlns:helpers="clr-namespace:Aquila.Helpers"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="Widgets"
      Style="{StaticResource BasePageStyle}"
      ScrollViewer.VerticalScrollBarVisibility="Auto"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

    <Page.Resources>
        <helpers:IntensityBrushConverter x:Key="Intensity"/>
    </Page.Resources>

    <StackPanel Margin="20,0,20,20">

        <TextBlock Text="Widgets" FontSize="18" FontWeight="SemiBold" Margin="2,12,0,0"/>

        <!-- Desktop surface (#24). It lives here rather than in Settings because this is where widgets are
             managed, and one owner avoids two views holding the same state. -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="Desktop"/>

        <ui:CardControl Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Show widgets on the desktop"/>
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Above the wallpaper, behind your windows, and click-through."/>
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ViewModel.ShowOnDesktop}"/>
        </ui:CardControl>

        <!-- Disabled rather than hidden while the surface is off. These used to be revealed by expanding
             the card, which kept the page tidy but also kept the feature invisible until someone happened
             to turn the switch on. Greyed out, they say what the surface is for before it is enabled. -->
        <ui:CardControl Icon="{ui:SymbolIcon Options24}"
                        IsEnabled="{Binding ViewModel.ShowOnDesktop}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Manage widgets"/>
                    <TextBlock Style="{StaticResource SettingHint}"
                               Text="Editing minimizes Aquila so you can see the desktop; a bar at the top brings it back. There you can drag widgets, and right-click one to change, remove, or send it to another screen."/>
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Content="Add widget"
                    Icon="{ui:SymbolIcon Add24}"
                    Appearance="Primary"
                    Command="{Binding ViewModel.AddWidgetCommand}"/>
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Edit widgets"
                    Icon="{ui:SymbolIcon Edit24}"
                    Command="{Binding ViewModel.StartEditingCommand}"/>
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Identify screens"
                    Icon="{ui:SymbolIcon Tv24}"
                    Command="{Binding ViewModel.IdentifyScreensCommand}"/>
            </StackPanel>
        </ui:CardControl>

        <!-- Preview only (#23): each reusable piece running on this machine's own sensors, read from the
             AquilaService that already exists. No pinning flow here; that belongs to #24/#31. -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="Pieces"/>
        <TextBlock Style="{StaticResource SettingHint}" Margin="2,-4,0,8"
                   Text="Each reusable widget piece, live, using this machine's own sensors."/>

        <controls:ResponsiveCardPanel Gap="8" MinCardWidth="220">

            <!-- Radial Gauge -->
            <ui:Card Padding="12,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <controls:LabeledTile Grid.Row="0" VerticalAlignment="Top"
                        Title="Radial Gauge" Width="160" Height="160">
                        <controls:LabeledTile.Tile>
                            <controls:RadialGauge
                                Sensor="{Binding ViewModel.Hardware.Cpus[0].Load.Total}"
                                Accent="{DynamicResource Aquila.Scheme.Accent}"/>
                        </controls:LabeledTile.Tile>
                    </controls:LabeledTile>
                    <TextBlock Grid.Row="1" VerticalAlignment="Top"
                               Text="CPU Usage — one value on a scale" FontSize="11" Opacity="0.5"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="160"/>
                </Grid>
            </ui:Card>

            <!-- Mini Sparkline -->
            <ui:Card Padding="12,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <controls:LabeledTile Grid.Row="0" VerticalAlignment="Top"
                        Title="Mini Sparkline" Width="220" Height="160">
                        <controls:LabeledTile.Tile>
                            <controls:MiniSparkline
                                Sensor="{Binding ViewModel.Hardware.Cpus[0].Temperature.Primary}"
                                Accent="{DynamicResource Aquila.Scheme.Accent}"/>
                        </controls:LabeledTile.Tile>
                    </controls:LabeledTile>
                    <TextBlock Grid.Row="1" VerticalAlignment="Top"
                               Text="CPU Temperature — trend line + current value" FontSize="11" Opacity="0.5"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                </Grid>
            </ui:Card>

            <!-- Sensor Meter -->
            <ui:Card Padding="12,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <controls:LabeledTile Grid.Row="0" VerticalAlignment="Top"
                        Title="Sensor Meter" Width="220">
                        <controls:LabeledTile.Tile>
                            <controls:SensorMeter
                                Label="CPU"
                                Sensor="{Binding ViewModel.Hardware.Cpus[0].Power.Package}"
                                Accent="{DynamicResource Aquila.Scheme.Accent}"
                                ValueText="{Binding ViewModel.Hardware.Cpus[0].Power.Package.Value, StringFormat='{}{0:F0}W', FallbackValue='--'}"/>
                        </controls:LabeledTile.Tile>
                    </controls:LabeledTile>
                    <TextBlock Grid.Row="1" VerticalAlignment="Top"
                               Text="CPU Power — labeled bar with a value" FontSize="11" Opacity="0.5"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>
                </Grid>
            </ui:Card>

            <!-- Stat Box -->
            <ui:Card Padding="12,10">
                <Grid HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>
                    <controls:LabeledTile Grid.Row="0" VerticalAlignment="Top"
                        Title="Stat Box" Width="120">
                        <controls:LabeledTile.Tile>
                            <controls:StatBox
                                Label="Temp" Unit="°C"
                                Value="{Binding ViewModel.Hardware.Gpus[0].Temperature.Primary.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                                Accent="{Binding ViewModel.Hardware.Gpus[0].Temperature.Primary.Value, Converter={StaticResource Intensity}, ConverterParameter=Temperature}"/>
                        </controls:LabeledTile.Tile>
                    </controls:LabeledTile>
                    <TextBlock Grid.Row="1" VerticalAlignment="Top"
                               Text="GPU Temperature — big number, colour-coded" FontSize="11" Opacity="0.5"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="120"/>
                </Grid>
            </ui:Card>

        </controls:ResponsiveCardPanel>
    </StackPanel>
</Page>
