<Page
    x:Class="Aquila.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Aquila.Controls"
    xmlns:cards="clr-namespace:Aquila.Controls.Cards"
    xmlns:helpers="clr-namespace:Aquila.Helpers"
    Style="{StaticResource BasePageStyle}"
    Title="DashboardPage"
    mc:Ignorable="d">

    <Page.Resources>
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="VerticalAlignment"        Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>

        <helpers:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

        <!-- Header chip. Bordered, unlike the old plain fill: with a page title now beside them these
             have to read as belonging to the header rather than floating over the cards. -->
        <Style x:Key="HeaderChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Page.Resources>

    <StackPanel>

        <!-- Header: the page's name on the left, its standing facts on the right.
             The chips used to sit alone against the right edge, which made them read as a notification
             hovering over the cards rather than as the page's own header. A title anchors them. -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- "Home", matching the rail. The mockup says "Dashboard", but the two must agree or the
                 page you clicked to is not the page you appear to be on. -->
            <TextBlock Grid.Column="0" Text="Home" VerticalAlignment="Center"
                       FontSize="22" FontWeight="SemiBold"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource HeaderChip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Timer24" FontSize="13" Margin="0,0,6,0" Opacity="0.45"/>
                        <TextBlock Style="{StaticResource MonoValue}" FontSize="11.5"
                                   Text="{Binding ViewModel.SystemUptime}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderChip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="13" Margin="0,0,6,0" Opacity="0.45"/>
                        <TextBlock Style="{StaticResource MonoValue}" FontSize="11.5"
                                   Text="{Binding ViewModel.CurrentDateTime}"/>
                    </StackPanel>
                </Border>

                <ui:Button Command="{Binding ViewModel.ToggleDashboardCommand}"
                           ToolTip="{Binding ViewModel.DashboardToggleTooltip}"
                           Appearance="Secondary" Padding="7,5">
                    <ui:SymbolIcon Symbol="{Binding ViewModel.DashboardToggleIcon}" FontSize="13"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <controls:ResponsiveCardPanel Gap="8" MinCardWidth="320">

            <!-- ── CPU card ─────────────────────────────────────────── -->
            <cards:CpuCard Cpu="{Binding ViewModel.Hardware.Cpus[0]}"
                           Visibility="{Binding ViewModel.ShowCpuCard}"/>

            <!-- ── GPU cards ─────────────────────────────────────────── -->
            <cards:GpuCard Gpu="{Binding ViewModel.Gpu1}"
                           Visibility="{Binding ViewModel.Gpu1, Converter={StaticResource NullToCollapsedConverter}}"/>
            <cards:GpuCard Gpu="{Binding ViewModel.Gpu2}"
                           Visibility="{Binding ViewModel.Gpu2, Converter={StaticResource NullToCollapsedConverter}}"/>

            <!-- ── RAM card ──────────────────────────────────────────── -->
            <cards:RamCard Memory="{Binding ViewModel.Hardware.Memory}"
                           Visibility="{Binding ViewModel.ShowMemoryCard}"/>

            <!-- ── Network card ──────────────────────────────────────── -->
            <cards:NetworkCard Network="{Binding ViewModel.Hardware.Networks[0]}"
                               Visibility="{Binding ViewModel.ShowNetworkCard}"/>

            <!-- ── Storage cards (one slot per drive) ───────────────── -->
            <cards:StorageCard Storage="{Binding ViewModel.Storage1}"
                               Visibility="{Binding ViewModel.Storage1, Converter={StaticResource NullToCollapsedConverter}}"/>
            <cards:StorageCard Storage="{Binding ViewModel.Storage2}"
                               Visibility="{Binding ViewModel.Storage2, Converter={StaticResource NullToCollapsedConverter}}"/>
            <cards:StorageCard Storage="{Binding ViewModel.Storage3}"
                               Visibility="{Binding ViewModel.Storage3, Converter={StaticResource NullToCollapsedConverter}}"/>
            <cards:StorageCard Storage="{Binding ViewModel.Storage4}"
                               Visibility="{Binding ViewModel.Storage4, Converter={StaticResource NullToCollapsedConverter}}"/>

            <!-- ── Temperatures card ─────────────────────────────────── -->
            <cards:TemperaturesCard
                Temperatures="{Binding ViewModel.Hardware.Motherboard.Temperature}"
                DieTemperature="{Binding ViewModel.Hardware.Cpus[0].Temperature.Primary}"
                Visibility="{Binding ViewModel.ShowTemperaturesCard}"/>

            <!-- ── Fans card ─────────────────────────────────────────── -->
            <cards:FansCard FanRows="{Binding ViewModel.FanRows}"
                            CpuFan="{Binding ViewModel.Hardware.Motherboard.CpuFan}"
                            Visibility="{Binding ViewModel.ShowFansCard}"/>

            <!-- ── Power card ────────────────────────────────────────── -->
            <cards:PowerCard
                TotalPower="{Binding ViewModel.Hardware.TotalPower}"
                CpuPower="{Binding ViewModel.Hardware.Cpus[0].Power.Package}"
                Gpu1Power="{Binding ViewModel.Gpu1.Power.Package}"
                Gpu2Power="{Binding ViewModel.Gpu2.Power.Package}"
                Visibility="{Binding ViewModel.ShowPowerCard}"/>

        </controls:ResponsiveCardPanel>

    </StackPanel>

</Page>
