<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         EMBER — Aquila's own colour scheme, drawn from the logo.

         The idea that shapes it: colour no longer says WHICH component this
         is — the icon already does that — it says HOW HOT it is. Freeing
         colour from identity lets it carry the one thing that actually
         changes, which is what a monitor is for. It also removes the reason
         the old Aquila.Cpu / Aquila.Chart.Cpu tokens existed, and the
         contradiction they had grown into (CPU was blue in one place and
         orange in another).

         A scheme defines COLOURS PER ROLE. It deliberately does NOT define
         when each role applies: that 80 °C counts as "alert" is a property
         of the metric, not of the palette (see IntensityBrushConverter). Keep
         them apart, or restyling would silently change meaning — and a
         shared scheme would impose someone else's thresholds.
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Ramp: cool ember → hot ember ──────────────────────────────────
         Dark values sit on near-black; light values are deepened so they
         hold contrast on a pale background. -->

    <Color x:Key="Aquila.Palette.Ember.1.Dark">#FFD9A8</Color>
    <Color x:Key="Aquila.Palette.Ember.2.Dark">#FFB765</Color>
    <Color x:Key="Aquila.Palette.Ember.3.Dark">#F5A623</Color>
    <Color x:Key="Aquila.Palette.Ember.4.Dark">#FF6B35</Color>
    <Color x:Key="Aquila.Palette.Ember.5.Dark">#DA3B01</Color>

    <Color x:Key="Aquila.Palette.Ember.1.Light">#B24500</Color>
    <Color x:Key="Aquila.Palette.Ember.2.Light">#CA5010</Color>
    <Color x:Key="Aquila.Palette.Ember.3.Light">#DA3B01</Color>
    <Color x:Key="Aquila.Palette.Ember.4.Light">#E85D04</Color>
    <Color x:Key="Aquila.Palette.Ember.5.Light">#9A2C00</Color>

    <!-- ── Roles ─────────────────────────────────────────────────────────
         Named by MEANING, so a different scheme can answer the same roles
         with entirely different hues and nothing downstream has to change. -->

    <!-- Identity and selection: active navigation, focus, primary button.
         Chrome, not data — which is why it may share a hue with a ramp step
         without causing confusion. -->
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Accent.Dark"   Color="{StaticResource Aquila.Palette.Ember.3.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Accent.Light"  Color="{StaticResource Aquila.Palette.Ember.3.Light}"/>

    <!-- The intensity ramp -->
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Normal.Dark"    Color="{StaticResource Aquila.Palette.Ember.2.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Normal.Light"   Color="{StaticResource Aquila.Palette.Ember.2.Light}"/>

    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Elevated.Dark"  Color="{StaticResource Aquila.Palette.Ember.3.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Elevated.Light" Color="{StaticResource Aquila.Palette.Ember.3.Light}"/>

    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Alert.Dark"     Color="{StaticResource Aquila.Palette.Ember.4.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Alert.Light"    Color="{StaticResource Aquila.Palette.Ember.4.Light}"/>

    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Critical.Dark"  Color="{StaticResource Aquila.Palette.Ember.5.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Critical.Light" Color="{StaticResource Aquila.Palette.Ember.5.Light}"/>

    <!-- Series: for when colour must DISTINGUISH rather than measure —
         download vs upload, two lines on one chart. Ember is deliberately
         monochrome, so these separate by lightness rather than hue; that
         keeps the scheme coherent, but it is the part most worth checking
         on screen with two lines actually overlapping. -->
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series1.Dark"  Color="{StaticResource Aquila.Palette.Ember.3.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series1.Light" Color="{StaticResource Aquila.Palette.Ember.3.Light}"/>

    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series2.Dark"  Color="{StaticResource Aquila.Palette.Ember.1.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series2.Light" Color="{StaticResource Aquila.Palette.Ember.1.Light}"/>

    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series3.Dark"  Color="{StaticResource Aquila.Palette.Ember.5.Dark}"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Series3.Light" Color="{StaticResource Aquila.Palette.Ember.5.Light}"/>

    <!-- Track: the unfilled part of bars and gauges. Tinted with the accent
         rather than neutral grey, so a bar reads as one object. -->
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Track.Dark"    Color="#21F5A623"/>
    <SolidColorBrush x:Key="Aquila.Scheme.Ember.Track.Light"   Color="#21CA5010"/>

</ResourceDictionary>
