<UserControl x:Class="Aquila.Controls.Cards.RamCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="340">
    <!-- Self-contained RAM card: bind Memory and it renders the whole card. The physical/virtual
         pool composition (StackedBar segments) is computed in code-behind; everything else binds
         straight to the SensorNodes. The card's content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
        <helpers:ZeroToCollapsedConverter x:Key="ZeroToCollapsed"/>
        <helpers:ThermalBrushConverter x:Key="Thermal"/>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: header + bar + legend + label -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="RAM" Style="{StaticResource SectionLabel}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock FontSize="26" FontWeight="Light"
                               Text="{Binding Memory.Data.Used.Value, StringFormat='{}{0:F1}', FallbackValue='--'}"/>
                    <TextBlock Text="GB" FontSize="12" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="2,0,0,4"/>
                </StackPanel>

                <TextBlock FontSize="12" Opacity="0.60" Margin="0,0,0,2"
                           Text="{Binding Memory.Data.Total.Value, StringFormat='de {0:F0} GB total', FallbackValue='--'}"/>

                <controls:StackedBar Height="8" Margin="0,6,0,4" Segments="{Binding Segments}"/>

                <StackPanel Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Background="{DynamicResource Aquila.Cpu}"/>
                            <TextBlock FontSize="11" Opacity="0.65"
                                       Text="{Binding Memory.Data.Used.Value, StringFormat='Física {0:F1} usada', FallbackValue='--'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Background="{DynamicResource Aquila.Ram}"/>
                            <TextBlock FontSize="11" Opacity="0.65"
                                       Text="{Binding Memory.Virtual.Used.Value, StringFormat='Virtual {0:F1} usada', FallbackValue='--'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Background="{DynamicResource Aquila.Cpu}" Opacity="0.35"/>
                            <TextBlock FontSize="11" Opacity="0.65"
                                       Text="{Binding Memory.Data.Available.Value, StringFormat='Física {0:F1} livre', FallbackValue='--'}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,5,0"
                                    Background="{DynamicResource Aquila.Ram}" Opacity="0.35"/>
                            <TextBlock FontSize="11" Opacity="0.65"
                                       Text="{Binding Memory.Virtual.Available.Value, StringFormat='Virtual {0:F1} livre', FallbackValue='--'}"/>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}"/>
                </StackPanel>

                <TextBlock Text="USAGE · 60s" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Memory.Load.Total.History}"
                SeriesColor="{DynamicResource Aquila.Chart.Ram}"
                MaxY="100"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>

            <!-- Row 2: DIMMs (hide when narrow) -->
            <StackPanel Grid.Row="2"
                        Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                <StackPanel Visibility="{Binding Memory.Dimms.Count, Converter={StaticResource ZeroToCollapsed}}">
                    <Border Style="{StaticResource Divider}"/>
                    <TextBlock Text="DIMMS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding Memory.Dimms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                       Foreground="{Binding Temperature.Value, Converter={StaticResource Thermal}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F1} {1}" FallbackValue="--">
                                                        <Binding Path="Temperature.Value"/>
                                                        <Binding Path="Temperature.Unit"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Opacity="0.55" HorizontalAlignment="Right"
                                                       Visibility="{Binding WarningTemperature.Value, Converter={StaticResource NullToCollapsed}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="warn {0:F0}°C • crit {1:F0}°C" FallbackValue="warn -- • crit --">
                                                        <Binding Path="WarningTemperature.Value"/>
                                                        <Binding Path="CriticalTemperature.Value"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>
