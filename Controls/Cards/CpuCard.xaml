<UserControl x:Class="Aquila.Controls.Cards.CpuCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="340">
    <!-- Self-contained CPU card: bind Cpu (and optionally Motherboard for the fan row) and it
         renders the whole card. Live Summary/Cores are computed in code-behind; everything else
         binds straight to the SensorNodes. The card's content uses itself as DataContext. -->
    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: header + stats + core bars + label -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="CPU" Style="{StaticResource SectionLabel}"/>

                <!-- Header: what it is on the left, how hard it is working on the right. The headline
                     reading is promoted out of the stat row so a glance answers the first question
                     without reading four boxes; the row below then holds only the detail. -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardIconChip}" Margin="0,0,9,0">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="14"
                                       Foreground="{DynamicResource Aquila.Scheme.Accent}"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Cpu.Name, FallbackValue='Processor'}"
                                   Style="{StaticResource ChipName}"/>
                        <TextBlock Text="{Binding Summary}"
                                   FontSize="10" Opacity="0.45" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Summary, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <!-- Coloured by the load, like the temperatures beside it. Aquila cannot know whether
                             85% is a build or something helping itself to the machine, and it is not its job
                             to guess — it reports the reading against the limits and lets you decide. -->
                        <TextBlock Style="{StaticResource CardBigValue}"
                                   Foreground="{Binding Cpu.Load.Total.Value, Converter={StaticResource Intensity}, ConverterParameter=Cpu.Load}"
                                   Text="{Binding Cpu.Load.Total.Value, StringFormat='{}{0:F0}', FallbackValue='--', TargetNullValue='--'}"/>
                        <TextBlock Style="{StaticResource CardBigUnit}" Text="%"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <controls:StatBox Label="Temp" Unit="°C" Margin="0,0,3,0"
                        Value="{Binding Cpu.Temperature.Primary.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                        Accent="{Binding Cpu.Temperature.Primary.Value, Converter={StaticResource Intensity}, ConverterParameter=Cpu.Temperature}"/>
                    <controls:StatBox Label="Eff. Clock" Unit="MHz" UnitSize="11" Margin="3,0"
                        Value="{Binding Cpu.Clock.CoresAverage.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                    <controls:StatBox Label="Power" Unit="W" Margin="3,0,0,0"
                        Value="{Binding Cpu.Power.Package.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                </UniformGrid>

                <StackPanel Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                    <TextBlock Text="CORE LOAD" Style="{StaticResource SectionLabel}"/>
                    <controls:BarGroup Items="{Binding Cores}" Accent="{DynamicResource Aquila.Scheme.Accent}" Margin="0,0,0,12"/>
                </StackPanel>

                <TextBlock Text="USAGE · 60s" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Cpu.Load.Total.History}"
                SeriesColor="{DynamicResource Aquila.Scheme.Series1}"
                MaxY="100"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
        </Grid>
    </ui:Card>
</UserControl>
