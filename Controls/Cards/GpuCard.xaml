<UserControl x:Class="Aquila.Controls.Cards.GpuCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Aquila.Controls"
             xmlns:helpers="clr-namespace:Aquila.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="340">
    <!-- Self-contained GPU card: bind Gpu and it renders usage/temp/clock/power stat boxes (reusing
         StatBox), a usage sparkline, VRAM usage and fan speeds. Pure bindings, no computed state.
         Content uses itself as DataContext. -->
    <UserControl.Resources>
        <helpers:ThermalBrushConverter x:Key="Thermal"/>
        <helpers:WidthThresholdConverter x:Key="WidthThreshold"/>
        <helpers:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </UserControl.Resources>

    <ui:Card Padding="12,10" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: header + stats + usage label -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="GPU" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="{Binding Gpu.Name}" Style="{StaticResource ChipName}" Margin="0,0,0,8"/>

                <UniformGrid Columns="4" Margin="0,0,0,10">
                    <controls:StatBox Label="Usage" Unit="%" Margin="0,0,3,0"
                        Value="{Binding Gpu.Load.Core.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"/>
                    <controls:StatBox Label="Temp" Unit="°C" Margin="3,0"
                        Value="{Binding Gpu.Temperature.Primary.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                        Accent="{Binding Gpu.Temperature.Primary.Value, Converter={StaticResource Thermal}}"/>
                    <controls:StatBox Label="Clock" Unit="MHz" UnitSize="11" Margin="3,0"
                        Value="{Binding Gpu.Clock.Core.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                        Accent="{DynamicResource Aquila.Gpu}"/>
                    <controls:StatBox Label="Power" Unit="W" Margin="3,0,0,0"
                        Value="{Binding Gpu.Power.Package.Value, StringFormat='{}{0:F0}', FallbackValue='--'}"
                        Accent="{DynamicResource Aquila.Gpu}"/>
                </UniformGrid>
                <TextBlock Text="USAGE · 60s" Style="{StaticResource SectionLabel}" Margin="0,4,0,2"
                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>
            </StackPanel>

            <!-- Row 1: sparkline fills remaining space -->
            <controls:SparklineChart Grid.Row="1" MinHeight="40"
                Values="{Binding Gpu.Load.Core.History}"
                SeriesColor="{DynamicResource Aquila.Chart.Gpu}"
                MaxY="100"
                Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=280}"/>

            <!-- Row 2: VRAM + fan (hide when narrow) -->
            <StackPanel Grid.Row="2">
                <StackPanel Margin="0,4,0,0"
                            Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                    <TextBlock Text="VRAM" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock FontSize="20" FontWeight="Normal"
                                   Foreground="{DynamicResource Aquila.Gpu}"
                                   Text="{Binding Gpu.Data.Used.Value, StringFormat='{}{0:F1}', FallbackValue='--'}"/>
                        <TextBlock FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,3"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="/ {0:F0} {1}" FallbackValue="/ -- ">
                                    <Binding Path="Gpu.Data.Total.Value"/>
                                    <Binding Path="Gpu.Data.Used.Unit"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource GpuBar}" Height="8"
                                 Value="{Binding Gpu.Data.Used.Value, FallbackValue=0}"
                                 Maximum="{Binding Gpu.Data.Total.Value, FallbackValue=1}"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="10" Opacity="0.40"
                                   Text="{Binding Gpu.Data.Used.Value, StringFormat='{}{0:F1} used', FallbackValue='used'}"/>
                        <TextBlock Grid.Column="1" FontSize="10" Opacity="0.40">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:F0} {1} total" FallbackValue="total">
                                    <Binding Path="Gpu.Data.Total.Value"/>
                                    <Binding Path="Gpu.Data.Used.Unit"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ui:Card}}, Converter={StaticResource WidthThreshold}, ConverterParameter=260}">
                    <StackPanel Visibility="{Binding Gpu.Fan.Primary.Value, Converter={StaticResource NullToCollapsed}}">
                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Opacity="0.14" Margin="0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Gpu.Fan.Secondary.Value}" Value="{x:Null}">
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Fan 1" Style="{StaticResource RowLabel}" Margin="0,0,0,2"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0} {1}" FallbackValue="--">
                                            <Binding Path="Gpu.Fan.Primary.Value"/>
                                            <Binding Path="Gpu.Fan.Primary.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Visibility="{Binding Gpu.Fan.Secondary.Value, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Text="Fan 2" Style="{StaticResource RowLabel}" Margin="0,0,0,2"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:F0} {1}" FallbackValue="--">
                                            <Binding Path="Gpu.Fan.Secondary.Value"/>
                                            <Binding Path="Gpu.Fan.Secondary.Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ui:Card>
</UserControl>
