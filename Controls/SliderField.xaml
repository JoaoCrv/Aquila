<UserControl x:Class="Aquila.Controls.SliderField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The reading first, right-aligned against the slider and in a width of its own, so the sliders of a card
         stand in one column whatever the numbers say. -->
    <DockPanel>
        <TextBlock x:Name="Reading" Width="44" Margin="0,0,10,0" VerticalAlignment="Center"
                   TextAlignment="Right" FontSize="12" Opacity="0.7"/>
        <Slider x:Name="Bar" Width="140" VerticalAlignment="Center" ValueChanged="OnSlid"/>
    </DockPanel>
</UserControl>
